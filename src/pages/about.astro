---
import Layout from "../components/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import "../styles/static-pages.css";

const title = "About AI Stats | Jonathan R. Reed";
const description =
	"How Jonathan R. Reed built AI Stats, where the model pricing, benchmark, and provider route data comes from, and how it gets checked.";
---

<Layout title={title} description={description} ogType="profile" image="/jonathan.avif">
	<Header currentPage="about" />
	<main id="main-content" class="eco-container static-page">
		<header class="static-hero about-hero">
			<img class="about-portrait" src="/jonathan.avif" alt="Jonathan R. Reed" width="1024" height="768" />
			<div class="about-intro">
				<h1>AI Stats, by Jonathan R. Reed</h1>
				<p class="static-lede">Compare model prices, speed and benchmark results.</p>
				<p class="sr-only">
					AI Stats documents public model pricing, benchmark coverage, provider
					availability, usage signals, context windows, latency metrics, and
					practical comparison notes for people evaluating large language models.
				</p>
				<div class="static-actions">
					<a href="https://github.com/jonathanRReed/" target="_blank" rel="noopener noreferrer" class="eco-btn eco-btn-secondary">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
						GitHub
					</a>
					<a href="https://jonathanrreed.com/" target="_blank" rel="noopener noreferrer" class="eco-btn eco-btn-secondary">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>
						Jonathan R. Reed
					</a>
					<a href="https://jonathanrreed.com/projects/" target="_blank" rel="noopener noreferrer" class="eco-btn eco-btn-secondary">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
						All Projects
					</a>
				</div>
			</div>
		</header>

		<div class="static-sections">
			<section class="static-section" aria-labelledby="about-project-heading">
				<h2 id="about-project-heading">About this project</h2>
				<div class="static-prose">
					<p>
						AI Stats brings model prices, speed and benchmark results into one place. Inspired by <a
							href="https://model-prices.vercel.app/"
							target="_blank"
							rel="noopener noreferrer">Theo Browne's model prices dashboard</a>.
					</p>
					<p>
						Pricing, Artificial Analysis benchmark scores, speed, and latency metrics are sourced from
						<a href="https://artificialanalysis.ai/" target="_blank" rel="noopener noreferrer">Artificial Analysis</a>
						via their free API.
					</p>
					<p>
						Epoch benchmark runs are sourced from Epoch AI's AI Benchmarking Hub and are used under Creative
						Commons Attribution licensing, with Apache 2.0 licensing for Aider Polyglot and Terminal Bench
						derived subsets.
					</p>
					<p>
						Model availability, routing metadata, provider directory data, usage totals, embedding models,
						modalities, context length, and route pricing are also sourced from
						<a href="https://openrouter.ai/" target="_blank" rel="noopener noreferrer">OpenRouter</a>
						public catalog data, with additional public catalog signals from
						<a href="https://huggingface.co/models" target="_blank" rel="noopener noreferrer">Hugging Face</a>
						and
						<a href="https://github.com/BerriAI/litellm" target="_blank" rel="noopener noreferrer">LiteLLM</a>
						for popularity, tags, pricing, context, and capability checks. Public catalog usage totals and
						route metadata are treated as routing or availability signals, not benchmark scores.
					</p>
					<p>
						Cost per million tokens, speed, and benchmark scores for reasoning, coding, math, and knowledge
						all sit next to each other, so the tradeoff is visible while you are still deciding. Sources sit
						next to the data, so you can check any number yourself.
					</p>
					<p class="static-note">
						AI Stats is public and noncommercial. I use it to learn, compare model tradeoffs, and keep my
						own model choices honest.
					</p>
				</div>
			</section>
		</div>
	</main>
	<Footer />
	<ScrollToTop />
</Layout>

<style>
	.about-hero {
		grid-template-columns: auto minmax(0, 1fr);
		align-items: start;
		gap: var(--space-5);
		max-width: none;
	}

	.about-portrait {
		width: 96px;
		height: 96px;
		object-fit: cover;
		border: 1px solid var(--line-0);
		border-radius: var(--radius-md);
		background: var(--surface-1);
	}

	.about-intro {
		display: grid;
		gap: var(--space-3);
	}

	@media (max-width: 640px) {
		.about-hero {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-4);
		}

		.about-portrait {
			width: 72px;
			height: 72px;
		}
	}
</style>
