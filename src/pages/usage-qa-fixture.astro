---
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import OpenRouterUsage from '../components/OpenRouterUsage';
import '../styles/openrouter-usage.css';
const rows=Array.from({length:30},(_,index)=>{
 const date=new Date(Date.parse('2026-09-02')+index*86400000).toISOString().slice(0,10);
 return index===13?[]:[{date,modelPermaslug:'fixture/alpha',totalTokens:String(4000+index*100)},
 ...(index%4?[{date,modelPermaslug:'fixture/beta',totalTokens:String(6000-index*80)}]:[]),
 {date,modelPermaslug:'other',totalTokens:'3000'}];
}).flat();
const snapshot={schemaVersion:1,period:'day',estimated:false,filters:{},asOf:'2026-10-02T02:00:00Z',
 startDate:'2026-09-02',endDate:'2026-10-01',missingDays:['2026-09-15'],
 sourceUrl:'https://openrouter.ai/rankings',licenseUrl:'https://creativecommons.org/licenses/by/4.0/',rows};
---
<Layout title="Usage QA fixture" description="Synthetic test fixture"><meta name="robots" content="noindex,nofollow" /><Header />
<main style="max-width:1200px;margin:4rem auto;padding:1rem"><h1>TEST DATA: usage interaction fixture</h1><p>These numbers are synthetic UI tests, not OpenRouter measurements.</p><OpenRouterUsage snapshot={snapshot} client:load /></main></Layout>
