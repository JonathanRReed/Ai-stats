---
import Layout from "../components/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import "../styles/static-pages.css";

const title = "Contact AI Stats | AI Model Comparison Support";
const description =
  "Contact Jonathan R. Reed about AI Stats, AI model pricing data, benchmark coverage, source corrections, privacy questions, and product feedback.";
---

<Layout title={title} description={description}>
  <Header currentPage="contact" />
  <main id="main-content" class="eco-container static-page">
    <header class="static-hero">
      <h1>Send AI Stats feedback, data corrections, or source questions.</h1>
    </header>

    <div class="static-sections">
      <section class="static-section" aria-labelledby="contact-project-heading">
        <h2 id="contact-project-heading">Project contact</h2>
        <div class="static-prose">
          <p>
            AI Stats is maintained by Jonathan R. Reed. Report bugs and data corrections on GitHub, or visit my portfolio for other contact options.
          </p>
          <div class="static-actions">
            <a class="eco-btn eco-btn-primary" href="https://github.com/JonathanRReed/Ai-stats/issues" target="_blank" rel="noopener noreferrer">Report an issue</a>
            <a class="eco-btn eco-btn-secondary" href="https://jonathanrreed.com/" target="_blank" rel="noopener noreferrer">Jonathan R. Reed</a>
          </div>
        </div>
      </section>

      <section class="static-section" aria-labelledby="contact-include-heading">
        <h2 id="contact-include-heading">What to include</h2>
        <div class="static-prose">
          <p>
            Include the affected model name, provider, source URL, expected value, and the page where the issue appears. This keeps pricing and benchmark updates auditable.
          </p>
          <p>
            For product feedback, say what comparison you were trying to make and which metric felt unclear. If it came down to cost, speed, context length, or benchmark quality, say which one. That tells me which part of the dashboard to fix first.
          </p>
        </div>
      </section>

      <section class="static-section" aria-labelledby="contact-types-heading">
        <h2 id="contact-types-heading">Common request types</h2>
        <div class="static-prose">
          <p>
            The most useful reports: a missing model, stale provider pricing, wrong OpenRouter route metadata, a benchmark naming mismatch, an accessibility problem, or a broken link.
          </p>
          <p>
            Please avoid sending private API keys, account credentials, unpublished benchmark data, or confidential provider terms. Public links and reproducible examples are enough for most corrections.
          </p>
        </div>
      </section>
    </div>
  </main>
  <Footer />
  <ScrollToTop />
</Layout>
