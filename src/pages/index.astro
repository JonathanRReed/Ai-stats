---
import Layout from "../components/Layout.astro";
import Dashboard from "../components/Dashboard.astro";
import { getDataFreshness, toIsoDate } from "../lib/data-freshness";

export const prerender = true;

const title = "AI Stats | Source-backed AI model evidence by Jonathan R. Reed";
const description =
  "Inspect source-backed AI model pricing, speed, benchmark coverage, and freshness across transparent evidence views without opaque recommendations.";

const { updatedAt } = await getDataFreshness();
const dateModified = toIsoDate(updatedAt) ?? undefined;
---

<Layout title={title} description={description} dateModified={dateModified}>
  <Dashboard />
</Layout>
