---
import Layout from "../components/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import { SECTION_NAV } from "../lib/site-nav";
import "../styles/static-pages.css";

const title = "Page not found | AI Stats";
const description =
  "The requested AI Stats page could not be found. Return to the model dashboard or compare AI models by price and performance.";
// Stats and Compare are the two buttons above; the list offers every other section.
const sectionLinks = SECTION_NAV.filter((link) => link.key !== "dashboard" && link.key !== "compare");
---

<Layout title={title} description={description} image="/logo.png" noindex={true}>
  <Header currentPage="not-found" />
  <main id="main-content" class="eco-container static-page">
    <header class="static-hero">
      <h1>This page is not in the dataset.</h1>
      <p class="static-meta">404 &middot; Page not found</p>
      <p class="static-lede">
        The address may have changed, or the page may never have existed. The model data is still available from the dashboard and comparison workspace.
      </p>
      <p class="static-lede" id="retired-matchup" hidden>
        This matchup does not have its own page in the current data. <a id="retired-matchup-link" href="/matchups">Browse every matchup</a>.
      </p>
      <div class="static-actions">
        <a class="eco-btn eco-btn-primary" href="/">Open model stats</a>
        <a class="eco-btn eco-btn-secondary" href="/compare">Compare models</a>
      </div>
    </header>

    <div class="static-sections">
      <section class="static-section" aria-labelledby="recovery-heading">
        <h2 id="recovery-heading">Find the right route.</h2>
        <nav aria-labelledby="recovery-heading">
          <ul class="static-link-list">
            {sectionLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
            <li><a href="/about">About the data</a></li>
            <li><a href="/contact">Report a broken link</a></li>
          </ul>
        </nav>
      </section>
    </div>
  </main>
  <script>
    // A matchup page exists only while both families are in the current rankings. For an address
    // that once had a page, point to where the same comparison lives now.
    import { readMatchupSearchIndex, resolveRetiredMatchup } from "../lib/head-to-head-search";
    if (/^\/compare\/.+-vs-.+/.test(window.location.pathname)) {
      fetch("/matchups.json")
        .then((response) => (response.ok ? response.json() : Promise.reject(new Error("unavailable"))))
        .then((payload) => {
          const note = document.getElementById("retired-matchup");
          const link = document.getElementById("retired-matchup-link");
          if (!note || !(link instanceof HTMLAnchorElement)) return;
          const target = resolveRetiredMatchup(window.location.pathname, readMatchupSearchIndex(payload));
          if (target) {
            link.href = target.url;
            link.textContent = target.label;
          }
          note.hidden = false;
        })
        .catch(() => { /* The page already links to every section. */ });
    }
  </script>
  <Footer />
  <ScrollToTop />
</Layout>
