---
import Layout from "../components/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CompareLive from "../components/compare/CompareLive";
import {getCompareReleaseManifest} from "../lib/compare-release-server";


import "../styles/compare-explorer.css";

export const prerender = true;
const manifest=await getCompareReleaseManifest();
const unavailableSources=manifest.sources.filter(source=>!source.available).map(source=>source.sourceKey);
const dateModified=manifest.generatedAt;
---
<Layout title="Compare AI Models: Price, Speed and Benchmarks | AI Stats"
  description="Compare AI model prices, speed and benchmark results. Filter models, inspect test settings and share your comparison."
  dateModified={dateModified}>
  <Header currentPage="compare" />
  <main id="main-content" class="compare-page">
    {unavailableSources.length?<p role="status">Partial catalog. Could not load: {unavailableSources.join(', ')}.</p>:null}
    <CompareLive client:load initial={manifest} />
  </main>
  <Footer />
</Layout>
