  .model-siblings { display: grid; gap: var(--space-3); }
  .model-siblings h2 { font-size: var(--text-lg); font-weight: 600; color: var(--ink-0); margin: 0; }
  .model-siblings ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); }
  .model-siblings li a { display: block; padding: var(--space-3) var(--space-4); color: var(--ink-0); text-decoration: none; font-size: var(--text-sm); }
  .model-siblings li a:hover { background: var(--surface-2); color: var(--signal-text); }
  .model-siblings p { margin: 0; font-size: var(--text-sm); }
  .model-siblings p a { color: var(--signal-text); }
  .receipt-wrap { overflow-x: auto; }
  @media (max-width: 640px) {
    .receipt th, .receipt td { padding-inline: var(--space-2); }
    .receipt-sourced { min-width: 32rem; }
  }

  /* Polish layer: readings first, then the reasoning-level comparison, then the receipts. */
  .model-hero { gap: var(--space-4); }
  .model-hero h1 { font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: -0.025em; }
  .model-provider { display: flex; align-items: center; gap: var(--space-2); margin-top: calc(var(--space-2) * -1); font-family: var(--font-sans); color: var(--ink-1); }
  .model-provider a { color: var(--ink-1); text-decoration: none; }
  .model-provider a:hover { color: var(--signal-text); text-decoration: underline; text-underline-offset: 3px; }
  .model-provider-mark { width: 16px; height: 16px; object-fit: contain; }
  .model-provider-mark.is-mono { filter: invert(1); }
  :root[data-theme="light"] .model-provider-mark.is-mono, html.light .model-provider-mark.is-mono { filter: none; }
  .model-readouts { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-7); margin: var(--space-2) 0; padding: var(--space-4) 0; border-block: 1px solid var(--line-0); }
