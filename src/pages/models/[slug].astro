  .model-readouts dd span { font-family: var(--font-sans); font-size: var(--text-xs); font-weight: 400; color: var(--ink-2); }
  .model-summary { color: var(--ink-2); font-size: var(--text-sm); max-width: 70ch; line-height: var(--leading-normal); }
