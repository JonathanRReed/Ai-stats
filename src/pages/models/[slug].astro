---
import CohortNotice from "../../components/CohortNotice.astro";
import { scriptSafeJson } from "../../lib/script-json";
import type { GetStaticPaths } from "astro";
import Layout from "../../components/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ScrollToTop from "../../components/ScrollToTop.astro";
import { getModelPageRecords } from "../../lib/model-pages-data";
import { buildModelSiblingLinks } from "../../lib/model-siblings";
import { getMatchups, findMatchupFamily } from "../../lib/head-to-head-data";
import { MATCHUPS_INDEX_PATH } from "../../lib/site-routes";
import { buildModelVariantRows, type ModelVariantRow } from "../../lib/model-variants";
import { modelDisplayFacets } from "../../lib/compare-catalog";
import { providerIcon } from "../../lib/provider-icons";
import { benchmarkPath, labPath } from "../../lib/site-routes";
import { getModelPosition } from "../../lib/model-position-data";
import ModelPosition from "../../components/models/ModelPosition.astro";
import ModelAlternatives from "../../components/models/ModelAlternatives.astro";
import "../../styles/model-page.css";
import {
  buildModelJsonLd,
  modelPageDescription,
  modelPageTitle,
  formatEpochScore,
  type ModelPageMetric,
  type ModelPageRecord,
} from "../../lib/model-pages";

export const prerender = true;

export const getStaticPaths = (async () => {
  const records = await getModelPageRecords();
  const siblingLinks = buildModelSiblingLinks(records);
  const variantRows = buildModelVariantRows(records);
  // Head-to-head pages exist for a bounded set of family pairs; link only to the ones that were built.
  const matchups = await getMatchups();
  const matchupsBySlug = new Map<string, { name: string; path: string }[]>();
  for (const matchup of matchups) {
    for (const [self, other] of [[matchup.a, matchup.b], [matchup.b, matchup.a]] as const) {
      const list = matchupsBySlug.get(self.slug) ?? [];
      list.push({ name: other.name, path: matchup.path });
      matchupsBySlug.set(self.slug, list);
    }
  }
  const matchupLinks = new Map<string, { name: string; path: string }[]>();
  for (const record of records) {
    const family = await findMatchupFamily(modelDisplayFacets(record.name).family, record.provider);
    if (family) matchupLinks.set(record.slug, (matchupsBySlug.get(family.slug) ?? []).slice(0, 8));
  }
  const titleCounts = new Map<string, number>();
  for (const record of records) {
    const title = modelPageTitle(record.name);
    titleCounts.set(title, (titleCounts.get(title) ?? 0) + 1);
  }
  return records.map((record) => {
    const siblings = siblingLinks.get(record.slug) ?? [];
    const defaultTitle = modelPageTitle(record.name);
    const pageTitle = (titleCounts.get(defaultTitle) ?? 0) > 1
      ? modelPageTitle(record.name, record.slug)
      : defaultTitle;
    return { params: { slug: record.slug }, props: { record, siblings, pageTitle, variants: variantRows.get(record.slug) ?? [], headToHead: matchupLinks.get(record.slug) ?? [] } };
  });
}) satisfies GetStaticPaths;

type Props = {
  record: ModelPageRecord;
  pageTitle: string;
  siblings: { name: string; path: string }[];
  variants: ModelVariantRow[];
  headToHead: { name: string; path: string }[];
};

const { record, siblings, variants, headToHead, pageTitle: title } = Astro.props;
const description = modelPageDescription(record);
const graph = buildModelJsonLd(record);
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph });

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
const formatDate = (value: string | null): string => {
  if (!value) return "Not recorded";
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? "Not recorded" : dateFormatter.format(date);
};
const money = (value: number | null): string =>
  value === null ? "Not available" : `$${value.toFixed(value < 0.01 ? 4 : 2)}`;
const formatMetric = (m: ModelPageMetric): string => {
  if (m.value === null) return "Not available";
  switch (m.unit) {
    case "USD":
      return money(m.value);
    case "tokens per second":
      return `${m.value.toFixed(1)} tokens/s`;
    case "seconds":
      return m.value < 1 ? `${(m.value * 1000).toFixed(0)} ms` : `${m.value.toFixed(2)} s`;
    case "tokens":
      return `${m.value.toLocaleString("en-US")} tokens`;
    case "fraction correct":
      return m.value <= 1 ? `${(m.value * 100).toFixed(1)}%` : m.value.toFixed(1);
    case "points":
      return m.value.toFixed(1);
    default:
      return String(m.value);
  }
};
const published = (group: ModelPageMetric[]) => group.filter((m) => m.value !== null);
const compact = (value: number | null): string =>
  value === null ? "Not available" : new Intl.NumberFormat("en", { notation: "compact", maximumFractionDigits: 1 }).format(value);
const runError = (value: number | null, unit: "native" | "percent" | "fraction" | null): string =>
  value === null ? "n/a" : formatEpochScore(value, unit);
const runSourceLabel = (run: ModelPageRecord["epochRuns"][number]): string =>
  run.sourceName && !/^https?:\/\//i.test(run.sourceName)
    ? run.sourceName
    : `${run.benchmark} benchmark source`;

const aaPricing = published(record.pricing.filter((m) => m.source === "Artificial Analysis"));
const missingMeasurements = [...record.pricing, ...record.speed, ...record.context, ...record.benchmarks, ...record.indexes].filter((m) => m.value === null);
const aaPrice = (key: string) => aaPricing.find((m) => m.key === key)?.value ?? null;
const close = (a: number | null, b: number | null) => a !== null && b !== null && Math.abs(a - b) < 0.001;
// OpenRouter list prices repeat the AA figure for most models; only show them when they differ.
const openRouterMatchesAa =
  close(aaPrice("price_1m_input_tokens"), record.pricing.find((m) => m.key === "openrouter_prompt_price_1m")?.value ?? null) &&
  close(aaPrice("price_1m_output_tokens"), record.pricing.find((m) => m.key === "openrouter_completion_price_1m")?.value ?? null);
const routePricing = published(
  record.pricing.filter((m) => m.source !== "Artificial Analysis" && !(openRouterMatchesAa && m.key.startsWith("openrouter_") && !m.key.includes("endpoint_min"))),
);
const measuredCount = published([...record.pricing, ...record.speed, ...record.context, ...record.benchmarks, ...record.indexes]).length;
const sourceNames = [...new Set(record.aliases.map((alias) => alias.sourceName))];
if (record.epochRuns.length) sourceNames.push("Epoch AI");

const metricValue = (group: ModelPageMetric[], key: string): number | null => group.find((m) => m.key === key)?.value ?? null;
const providerMark = providerIcon(record.provider, record.name);
// The four readings people come for. A reading that was not measured is left out, never shown as zero.
const readouts = [
  { label: "AA Intelligence Index", value: metricValue(record.indexes, "aa_intelligence_index")?.toFixed(1) ?? null, unit: "points" },
  { label: "Input price", value: aaPrice("price_1m_input_tokens") === null ? null : money(aaPrice("price_1m_input_tokens")), unit: "per 1M tokens" },
  { label: "Output price", value: aaPrice("price_1m_output_tokens") === null ? null : money(aaPrice("price_1m_output_tokens")), unit: "per 1M tokens" },
  { label: "Output speed", value: metricValue(record.speed, "median_output_tokens_per_second")?.toFixed(1) ?? null, unit: "tokens/s" },
].filter((item): item is { label: string; value: string; unit: string } => item.value !== null);
const family = modelDisplayFacets(record.name).family;
const variantTop = Math.max(0, ...variants.map((row) => row.index ?? 0));
// "Claude Opus 5.5 (Max, Default Fallback)" reads as "Max, Default Fallback" inside its own family table.
const variantLabel = (row: ModelVariantRow): string => row.name.match(/\(([^)]*)\)\s*$/)?.[1] ?? row.name;

const position = await getModelPosition(record.id);

// Receipt sections with nothing published collapse into one "Not measured" row, keeping their sentence.
const receiptIndexes = published(record.indexes);
const receiptSpeed = published(record.speed);
const receiptBenchmarks = published(record.benchmarks);
const emptyPanels = [
  !receiptIndexes.length ? { title: "Artificial Analysis indexes", sentence: "No published AA index values for this record." } : null,
  !aaPricing.length && !routePricing.length ? { title: "Pricing", sentence: "No published token prices for this record." } : null,
  !receiptSpeed.length ? { title: "Speed and latency", sentence: "No published speed or latency measurements for this record." } : null,
  !receiptBenchmarks.length ? { title: "Benchmark scores", sentence: "No published individual AA benchmark scores for this record." } : null,
].filter((panel): panel is { title: string; sentence: string } => panel !== null);
const missingGroups = [
  { title: "Pricing", metrics: record.pricing },
  { title: "Speed and latency", metrics: record.speed },
  { title: "Context", metrics: record.context },
  { title: "Benchmark scores", metrics: record.benchmarks },
  { title: "Indexes", metrics: record.indexes },
].map((group) => ({ ...group, metrics: group.metrics.filter((m) => m.value === null) })).filter((group) => group.metrics.length);

const links = [
  { href: record.routes.aiStatsCompare, label: "Compare on AI Stats", primary: true, external: false },
  { href: record.routes.aiDragRace, label: "Race it from your connection", primary: false, external: true },
  record.routes.promptInfo ? { href: record.routes.promptInfo, label: "Cost a workload on Prompt Info", primary: false, external: true } : null,
  { href: record.routes.aiNewsSearch, label: "Announcements on AI News", primary: false, external: true },
  record.routes.poliBench ? { href: record.routes.poliBench, label: "Political-response profile on PoliBench", primary: false, external: true } : null,
  { href: `/api/model-pages/${record.slug}.json`, label: "Download JSON", primary: false, external: false },
].filter((link): link is NonNullable<typeof link> => link !== null);

const sourceLinks = [
  { name: "Artificial Analysis", href: "https://artificialanalysis.ai/", note: "Prices, speed, latency, benchmark scores, and the three indexes." },
  record.catalog.openRouterUrl ? { name: "OpenRouter", href: record.catalog.openRouterUrl, note: "Catalog identity, context length, route prices, and modalities." } : null,
  record.catalog.huggingFaceUrl ? { name: "Hugging Face Hub", href: record.catalog.huggingFaceUrl, note: "Public repository activity." } : null,
  record.catalog.liteLlmId ? { name: "LiteLLM", href: "https://github.com/BerriAI/litellm", note: "Token limits and capability flags." } : null,
  record.epochRuns.length ? { name: "Epoch AI Benchmarking Hub", href: "https://epoch.ai/benchmarks", note: "Independent benchmark runs listed below." } : null,
  record.poliBench ? { name: "PoliBench", href: record.poliBench.url, note: "Measured political-response profile, no claim about beliefs." } : null,
].filter((link): link is NonNullable<typeof link> => link !== null);
---

<Layout title={title} description={description} dateModified={record.lastSeenDate ?? undefined}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={scriptSafeJson(jsonLd)} />
  </Fragment>
  <Header currentPage="models" />

  <main id="main-content" class="eco-container model-page">
    <nav class="model-crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">AI Stats</a></li>
        <li><a href="/models">Models</a></li>
        <li aria-current="page">{record.name}</li>
      </ol>
    </nav>
    <CohortNotice />

    <header class="model-hero">
      <h1>{record.name}</h1>
      <p class="model-provider">
        {providerMark ? <img class:list={["model-provider-mark", { "is-mono": providerMark.mono }]} src={providerMark.src} alt="" width="16" height="16" /> : null}
        <a href={labPath(record.provider)}>{record.provider}</a>
      </p>
      {readouts.length ? (
        <dl class="model-readouts">
          {readouts.map((item) => <div><dt>{item.label}</dt><dd>{item.value} <span>{item.unit}</span></dd></div>)}
        </dl>
      ) : null}
      <p class="model-summary">{record.aaEvidenceNote}</p>
      <p class="model-summary">
        Price, speed and benchmarks from named sources. Blended price uses 3:1 input/output weighting.
      </p>
      <dl class="model-facts eco-joined">
        <div>
          <dt>First observed</dt>
          <dd><time datetime={record.firstSeen ?? undefined}>{formatDate(record.firstSeen)}</time></dd>
        </div>
        <div>
          <dt>Last observed</dt>
          <dd><time datetime={record.lastSeen ?? undefined}>{formatDate(record.lastSeen)}</time></dd>
        </div>
        <div>
          <dt>Measurements</dt>
          <dd>{measuredCount}</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>{record.current ? "In the homepage cohort" : "Outside the homepage cohort"}</dd>
        </div>
      </dl>
      <div class="model-actions">
        {links.map((link) => (
          <a
            href={link.href}
            class={`eco-btn ${link.primary ? "eco-btn-primary" : "eco-btn-secondary"}`}
            rel={link.external ? "noopener" : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
    </header>

    {position ? <ModelPosition position={position} /> : null}
    {position ? <ModelAlternatives position={position} /> : null}

    {variants.length ? (
      <section class="model-variants" aria-labelledby="variants-heading">
        <header>
          <h2 id="variants-heading">{family} at each reasoning level</h2>
          <p>The same model under different reasoning settings, as Artificial Analysis measured each one. Index bars share one scale from zero.</p>
        </header>
        <div class="receipt-wrap"><table class="variants-table">
          <thead>
            <tr>
              <th scope="col">Reasoning level</th>
              <th scope="col" class="num">AA Index</th>
              <th scope="col"><span class="sr-only">AA Index bar</span></th>
              <th scope="col" class="num">Blended $/1M</th>
              <th scope="col" class="num">Tokens/s</th>
            </tr>
          </thead>
          <tbody>
            {variants.map((row) => (
              <tr aria-current={row.slug === record.slug ? "true" : undefined}>
                <th scope="row">{row.slug === record.slug ? <span>{variantLabel(row)} <small>This page</small></span> : <a href={row.path}>{variantLabel(row)}</a>}</th>
                <td class="num">{row.index === null ? "Not available" : row.index.toFixed(1)}</td>
                <td class="variant-bar-cell" aria-hidden="true">{row.index !== null && variantTop > 0 ? <span class="variant-bar" style={`width:${Math.max(0, (row.index / variantTop) * 100).toFixed(1)}%`}></span> : null}</td>
                <td class="num">{row.blendedPrice === null ? "Not available" : money(row.blendedPrice)}</td>
                <td class="num">{row.outputSpeed === null ? "Not available" : row.outputSpeed.toFixed(1)}</td>
              </tr>
            ))}
          </tbody>
        </table></div>
      </section>
    ) : null}

    <div class="model-receipts">
      {receiptIndexes.length ? (
        <section class="receipt-row" aria-labelledby="indexes-heading">
          <header><h2 id="indexes-heading">Artificial Analysis indexes</h2><p>Points on Artificial Analysis’s versioned scales.</p></header>
          <div class="receipt-wrap"><table class="receipt receipt-sourced">
            <colgroup><col class="col-measure" /><col class="col-value" /><col class="col-source" /></colgroup>
            <thead><tr><th scope="col">Index</th><th scope="col" class="num">Points</th><th scope="col">Source</th></tr></thead>
            <tbody>
              {receiptIndexes.map((m) => <tr><th scope="row">{m.label}</th><td class="num">{formatMetric(m)}</td><td>{m.source}</td></tr>)}
            </tbody>
          </table></div>
        </section>
      ) : null}

      {aaPricing.length || routePricing.length ? (
        <section class="receipt-row" aria-labelledby="pricing-heading">
          <header>
            <h2 id="pricing-heading">Pricing</h2>
            <p>US dollars per one million tokens.</p>
          </header>
          <div class="receipt-wrap"><table class="receipt receipt-sourced">
            <colgroup><col class="col-measure" /><col class="col-value" /><col class="col-source" /></colgroup>
            <thead>
              <tr><th scope="col">Measure</th><th scope="col" class="num">Value</th><th scope="col">Source</th></tr>
            </thead>
            <tbody>
              {aaPricing.map((m) => (
                <tr><th scope="row">{m.label}</th><td class="num">{formatMetric(m)}</td><td>{m.source}</td></tr>
              ))}
              {routePricing.map((m) => (
                <tr><th scope="row">{m.label}</th><td class="num">{formatMetric(m)}</td><td>{m.source}</td></tr>
              ))}
            </tbody>
          </table></div>
        </section>
      ) : null}

      {receiptSpeed.length ? (
        <section class="receipt-row" aria-labelledby="speed-heading">
          <header>
            <h2 id="speed-heading">Speed and latency</h2>
            <p>Medians published by Artificial Analysis. Your own route will differ.</p>
          </header>
          <div class="receipt-wrap"><table class="receipt receipt-sourced">
            <colgroup><col class="col-measure" /><col class="col-value" /><col class="col-source" /></colgroup>
            <thead>
              <tr><th scope="col">Measure</th><th scope="col" class="num">Value</th><th scope="col">Source</th></tr>
            </thead>
            <tbody>
              {receiptSpeed.map((m) => (
                <tr><th scope="row">{m.label}</th><td class="num">{formatMetric(m)}</td><td>{m.source}</td></tr>
              ))}
            </tbody>
          </table></div>
        </section>
      ) : null}

      <section class="receipt-row" aria-labelledby="context-heading">
        <header>
          <h2 id="context-heading">Context and capabilities</h2>
          <p>Limits as listed by public catalogs, not measured here.</p>
        </header>
        <div class="receipt-wrap"><table class="receipt receipt-sourced">
          <colgroup><col class="col-measure" /><col class="col-value" /><col class="col-source" /></colgroup>
          <thead>
            <tr><th scope="col">Measure</th><th scope="col" class="num">Value</th><th scope="col">Source</th></tr>
          </thead>
          <tbody>
            {published(record.context).map((m) => (
              <tr><th scope="row">{m.label}</th><td class="num">{formatMetric(m)}</td><td>{m.source}</td></tr>
            ))}
            <tr>
              <th scope="row">Capabilities</th>
              <td>{record.catalog.capabilities.length ? record.catalog.capabilities.join(", ") : "Not listed"}</td>
              <td>OpenRouter, LiteLLM</td>
            </tr>
            {record.catalog.inputModalities.length ? (
              <tr>
                <th scope="row">Modalities</th>
                <td>{record.catalog.inputModalities.join(", ")} in, {record.catalog.outputModalities.join(", ") || "text"} out</td>
                <td>OpenRouter</td>
              </tr>
            ) : null}
          </tbody>
        </table></div>
      </section>

      {receiptBenchmarks.length ? (
        <section class="receipt-row" aria-labelledby="benchmarks-heading">
          <header>
            <h2 id="benchmarks-heading">Benchmark scores</h2>
            <p>Available benchmark scores from Artificial Analysis. Unavailable values are not zero.</p>
          </header>
          <div class="receipt-wrap"><table class="receipt receipt-sourced">
            <colgroup><col class="col-measure" /><col class="col-value" /><col class="col-source" /></colgroup>
            <thead>
              <tr><th scope="col">Benchmark</th><th scope="col" class="num">Score</th><th scope="col">Source</th></tr>
            </thead>
            <tbody>
              {receiptBenchmarks.map((m) => (
                <tr><th scope="row"><a href={benchmarkPath(m.key)}>{m.label}</a></th><td class="num">{formatMetric(m)}</td><td>{m.source}</td></tr>
              ))}
            </tbody>
          </table></div>
        </section>
      ) : null}

      {record.epochRuns.length ? (
        <section class="receipt-row" aria-labelledby="epoch-heading">
          <header>
            <h2 id="epoch-heading">Epoch AI benchmark runs</h2>
            <p>Runs matched through reviewed Epoch model identifiers. Scores retain the publisher’s reported unit and version.</p>
          </header>
          <div class="receipt-wrap"><table class="receipt receipt-epoch">
            <thead>
              <tr><th scope="col">Benchmark</th><th scope="col">Metric</th><th scope="col">Version</th><th scope="col">Conditions</th><th scope="col" class="num">Score</th><th scope="col" class="num">Std. error</th><th scope="col">Run source</th></tr>
            </thead>
            <tbody>
              {record.epochRuns.map((run) => (
                <tr>
                  <th scope="row"><a href={benchmarkPath(run.benchmarkSlug)}>{run.benchmark}</a></th>
                  <td>{run.scoreMetric ?? "Not recorded"}</td>
                  <td>{run.benchmarkVersion ?? "Not recorded"}</td>
                  <td>{run.conditions ? Object.entries(run.conditions).map(([key,value])=>`${key}: ${value}`).join(" · ") : "Not recorded"}</td>
                  <td class="num">{formatEpochScore(run.score, run.scoreUnit)}{run.score === null ? "" : run.scoreUnit === "fraction" || run.scoreUnit === "percent" ? "" : run.scoreUnit === "native" ? " (native)" : " (unit not reported)"}</td>
                  <td class="num">{runError(run.stderr, run.scoreUnit)}</td>
                  <td>{run.sourceLink ? <a href={run.sourceLink} rel="noopener noreferrer">{runSourceLabel(run)}</a> : runSourceLabel(run)}</td>
                </tr>
              ))}
            </tbody>
          </table></div>
        </section>
      ) : null}

      {emptyPanels.length ? (
        <section class="receipt-row receipt-empty" aria-labelledby="empty-heading">
          <header>
            <h2 id="empty-heading">Not measured for this record</h2>
            <p>Sections with no published value. A gap is not a zero.</p>
          </header>
          <ul class="receipt-empty-list">
            {emptyPanels.map((panel) => <li><strong>{panel.title}.</strong> {panel.sentence}</li>)}
          </ul>
        </section>
      ) : null}

      {missingMeasurements.length ? <details class="receipt-row receipt-missing">
        <summary>
          <h2>Unavailable measurements ({missingMeasurements.length})</h2>
          <p>These fields were not reported for this record. They are not zero.</p>
        </summary>
        <div class="missing-groups">
          {missingGroups.map((group) => (
            <div>
              <h3>{group.title}</h3>
              <ul>{group.metrics.map((metric) => <li>{metric.label} <span>{metric.source}</span></li>)}</ul>
            </div>
          ))}
        </div>
      </details> : null}

      <section class="receipt-row" aria-labelledby="catalog-heading">
        <header>
          <h2 id="catalog-heading">Catalog identity</h2>
          <p>The keys other tools use for this model. Exact matches only, so a missing row means no confirmed alias.</p>
        </header>
        <div class="receipt-wrap"><table class="receipt">
          <colgroup><col class="col-measure" /><col class="col-value" /><col class="col-source" /></colgroup>
          <thead>
            <tr><th scope="col">Source</th><th scope="col">Identifier</th><th scope="col">Detail</th></tr>
          </thead>
          <tbody>
            {record.aliases.map((alias) => (
              <tr>
                <th scope="row">{alias.sourceName}</th>
                <td><code>{alias.sourceModelKey}</code></td>
                <td>{alias.sourceModelName && alias.sourceModelName !== record.name ? alias.sourceModelName : alias.matchMethod === "source_native" ? "Source of record" : "Exact catalog match"}</td>
              </tr>
            ))}
            {record.catalog.usageRank ? (
              <tr><th scope="row">OpenRouter usage position</th><td>#{record.catalog.usageRank}</td><td>{compact(record.catalog.usageTokens)} tokens in the usage window</td></tr>
            ) : null}
            {record.catalog.endpointProviderCount ? (
              <tr><th scope="row">OpenRouter routes</th><td>{record.catalog.endpointProviderCount} providers</td><td>{record.catalog.endpointProviders.slice(0, 8).join(", ")}{record.catalog.quantizations.length ? ` · ${record.catalog.quantizations.join(", ")}` : ""}</td></tr>
            ) : null}
            {record.catalog.huggingFaceDownloads ? (
              <tr><th scope="row">Hugging Face activity</th><td>{compact(record.catalog.huggingFaceDownloads)} downloads</td><td>{compact(record.catalog.huggingFaceLikes)} likes · updated {formatDate(record.catalog.huggingFaceLastModified)}</td></tr>
            ) : null}
          </tbody>
        </table></div>
      </section>

      {record.poliBench ? (
        <section class="receipt-row" aria-labelledby="polibench-heading">
          <header>
            <h2 id="polibench-heading">PoliBench profile</h2>
            <p>Measured model output on political items. It says nothing about what a model believes.</p>
          </header>
          <div class="receipt-body">
            <div class="receipt-wrap"><table class="receipt">
              <colgroup><col class="col-measure" /><col class="col-value" /><col class="col-source" /></colgroup>
              <tbody>
                <tr><th scope="row">Evidence</th><td colspan="2">{record.poliBench.evidenceLabel}</td></tr>
                <tr><th scope="row">Run status</th><td colspan="2">{record.poliBench.status}</td></tr>
                <tr><th scope="row">Completion rate</th><td class="num">{record.poliBench.completionRate.toFixed(1)}%</td><td>Share of expected responses received</td></tr>
                <tr><th scope="row">Robustness</th><td class="num">{record.poliBench.robustness.toFixed(1)}%</td><td>Stability across paraphrases and reruns</td></tr>
                <tr><th scope="row">Last run finished</th><td colspan="2">{formatDate(record.poliBench.lastRunFinishedAt)}</td></tr>
              </tbody>
            </table></div>
            <p class="panel-foot"><a href={record.poliBench.url} rel="noopener">Full profile and artifacts on PoliBench</a></p>
          </div>
        </section>
      ) : null}

      <section class="receipt-row" aria-labelledby="sources-heading">
        <header>
          <h2 id="sources-heading">Sources</h2>
          <p>Where each value came from. Corrections go to the source first, then to the contact page.</p>
        </header>
        <div class="receipt-body">
          <ul class="source-list">
            {sourceLinks.map((source) => (
              <li>
                <a href={source.href} rel="noopener noreferrer">{source.name}</a>
                <span>{source.note}</span>
              </li>
            ))}
          </ul>
          <p class="panel-foot">Counted sources for this model: {sourceNames.join(", ")}. Contents belong to the named sources. Search and AI answers with a link back are welcome, training is not. <a href="/about">How the data is gathered</a>.</p>
        </div>
      </section>
    </div>

    {headToHead.length ? (
      <nav class="model-siblings" aria-labelledby="matchups-heading">
        <h2 id="matchups-heading">{modelDisplayFacets(record.name).family} head to head</h2>
        <ul class="eco-joined">
          {headToHead.map((matchup) => (
            <li><a href={matchup.path}>vs {matchup.name}</a></li>
          ))}
        </ul>
        <p><a href={MATCHUPS_INDEX_PATH}>Every matchup</a></p>
      </nav>
    ) : null}

    {siblings.length ? (
      <nav class="model-siblings" aria-labelledby="siblings-heading">
        <h2 id="siblings-heading">More from {record.provider}</h2>
        <ul class="eco-joined">
          {siblings.map((sibling) => (
            <li><a href={sibling.path}>{sibling.name}</a></li>
          ))}
        </ul>
        <p><a href="/models">Every model with a page</a></p>
      </nav>
    ) : null}
  </main>

  <Footer />
  <ScrollToTop />
</Layout>

<style is:global>
