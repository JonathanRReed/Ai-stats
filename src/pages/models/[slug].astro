  .variants-table tbody tr:last-child th, .variants-table tbody tr:last-child td { border-bottom: 1px solid var(--line-0); }
  .variants-table thead th { border-top: 0; font-size: var(--text-xs); font-weight: 500; color: var(--ink-2); }
  .variants-table th:first-child, .variants-table td:first-child { padding-left: 0; }
  .variants-table tbody th { font-weight: 500; white-space: nowrap; }
  .variants-table tbody th a { color: var(--ink-1); text-decoration: none; }
  .variants-table tbody th a:hover { color: var(--ink-0); text-decoration: underline; text-underline-offset: 3px; }
  .variants-table tbody th small { margin-left: var(--space-2); font-size: var(--text-xs); font-weight: 400; color: var(--signal-text); }
  .variants-table .num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; color: var(--ink-1); }
  .variants-table tr[aria-current="true"] th, .variants-table tr[aria-current="true"] .num { color: var(--ink-0); }
  .variants-table tbody tr:hover { background: var(--surface-1); }
  .variant-bar-cell { width: 42%; min-width: 8rem; }
  .variant-bar { display: block; height: 8px; min-width: 2px; border-radius: 2px; background: var(--ink-3); }
  tr[aria-current="true"] .variant-bar { background: var(--signal); }
  .receipt-wrap { min-width: 0; overflow-x: auto; scrollbar-width: thin; scrollbar-color: var(--line-1) transparent; }
</style>
