---
import CohortNotice from "../../components/CohortNotice.astro";
import { scriptSafeJson } from "../../lib/script-json";
import CatalogCoverage from "../../components/CatalogCoverage.astro";
import Layout from "../../components/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ScrollToTop from "../../components/ScrollToTop.astro";
import { getModelPageRecords } from "../../lib/model-pages-data";
import { getDataFreshness, toIsoDate, formatDataDate } from "../../lib/data-freshness";
import { AUTHOR_REF } from "../../lib/author";
import { SITE_ORIGIN, type ModelPageRecord } from "../../lib/model-pages";

export const prerender = true;

const [records, freshness] = await Promise.all([getModelPageRecords(), getDataFreshness()]);
const dateModified = toIsoDate(freshness.updatedAt) ?? undefined;
const refreshed = formatDataDate(freshness.updatedAt) ?? "unknown";

const byProvider = new Map<string, ModelPageRecord[]>();
for (const record of records) {
  const group = byProvider.get(record.provider) ?? [];
  group.push(record);
  byProvider.set(record.provider, group);
}
const providers = [...byProvider.entries()]
  .map(([provider, group]) => {
    const models = [...group].sort(
      (a, b) =>
        Number(b.indexes[0]?.value ?? -1) - Number(a.indexes[0]?.value ?? -1) || a.name.localeCompare(b.name),
    );
    const indexes = models
      .map((model) => model.indexes.find((m) => m.key === "aa_intelligence_index")?.value ?? null)
      .filter((value): value is number => value !== null);
    return {
      provider,
      id: provider.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "") || "provider",
      models,
      indexRange: indexes.length
        ? indexes.length === 1
          ? indexes[0].toFixed(1)
          : `${Math.min(...indexes).toFixed(1)} to ${Math.max(...indexes).toFixed(1)}`
        : null,
    };
  })
  .sort((a, b) => b.models.length - a.models.length || a.provider.localeCompare(b.provider));
const hasRecords = records.length > 0;

const title = "AI model prices, speed and benchmarks | AI Stats";
const description = `${records.length} AA model pages from ${providers.length} providers, each with a page listing price per million tokens, output speed, context length, benchmark scores, and catalog identifiers with source and observation dates.`;

const get = (group: { key: string; value: number | null }[], key: string) => group.find((m) => m.key === key)?.value ?? null;
const money = (value: number | null): string => (value === null ? "n/a" : `$${value.toFixed(value < 0.01 ? 4 : 2)}`);
const points = (value: number | null): string => (value === null ? "n/a" : value.toFixed(1));
const tps = (value: number | null): string => (value === null ? "n/a" : value.toFixed(0));
/** Raw value for the sortable table; a missing value stays an empty attribute, never zero. */
const raw = (value: number | null): string => (value === null ? "" : String(value));
const ctx = (value: number | null): string => {
  if (value === null) return "n/a";
  if (value >= 1_000_000) return `${(value / 1_000_000).toFixed(value % 1_000_000 === 0 ? 0 : 1)}M`;
  if (value >= 1_000) return `${Math.round(value / 1_000)}K`;
  return String(value);
};

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Dataset",
      "@id": `${SITE_ORIGIN}/models#dataset`,
      name: "AI Stats model measurements",
      description,
      url: `${SITE_ORIGIN}/models`,
      creator: AUTHOR_REF,
      isPartOf: { "@id": `${SITE_ORIGIN}/#website` },
      ...(dateModified ? { dateModified } : {}),
      isBasedOn: [
        "https://artificialanalysis.ai/",
        "https://epoch.ai/benchmarks",
        "https://openrouter.ai/",
        "https://huggingface.co/",
        "https://github.com/BerriAI/litellm",
      ],
      distribution: [
        { "@type": "DataDownload", encodingFormat: "application/json", contentUrl: `${SITE_ORIGIN}/api/models.json` },
        { "@type": "DataDownload", encodingFormat: "text/plain", contentUrl: `${SITE_ORIGIN}/llms-full.txt` },
      ],
      hasPart: providers.slice(0, 40).flatMap((group) =>
        group.models.slice(0, 3).map((record) => ({ "@id": `${record.url}#dataset` })),
      ),
      inLanguage: "en-US",
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "AI Stats", item: `${SITE_ORIGIN}/` },
        { "@type": "ListItem", position: 2, name: "Models", item: `${SITE_ORIGIN}/models` },
      ],
    },
  ],
});
import { providerIcon } from "../../lib/provider-icons";
---

<Layout title={title} description={description} dateModified={dateModified}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={scriptSafeJson(jsonLd)} />
  </Fragment>
  <Header currentPage="models" />

  <main id="main-content" class="eco-container models-index">
    <CohortNotice />
    <header class="models-hero">
      <h1>Models</h1>
      <p class="models-lead">
        {hasRecords
          ? `Prices, speed and benchmark results for ${records.length} models.`
          : "Model data is temporarily unavailable."}
      </p>
      {hasRecords ? (
      <dl class="models-facts eco-joined">
        <div><dt>Data refreshed</dt><dd>{refreshed}</dd></div>
        <div><dt>Models</dt><dd>{records.length}</dd></div>
        <div><dt>Providers</dt><dd>{providers.length}</dd></div>
        <div><dt>Machine-readable</dt><dd><a href="/api/models.json">models.json</a> · <a href="/llms-full.txt">llms-full.txt</a></dd></div>
      </dl>
      ) : null}
      <CatalogCoverage />
      {hasRecords ? (
      <div class="models-find" id="models-find" hidden>
        <label class="models-search">
          <span class="eco-label">Find a model</span>
          <input
            type="search"
            id="models-search-input"
            placeholder="Model or provider name"
            autocomplete="off"
            spellcheck="false"
            aria-describedby="models-search-status"
          />
        </label>
        <div class="models-find-actions">
          <div class="models-view" role="group" aria-label="Layout">
            <button type="button" class="eco-btn eco-btn-secondary eco-btn-sm" data-view="labs" aria-pressed="true">By lab</button>
            <button type="button" class="eco-btn eco-btn-secondary eco-btn-sm" data-view="table" aria-pressed="false">One table</button>
          </div>
          <button type="button" id="models-expand" class="eco-btn eco-btn-secondary eco-btn-sm">Open every provider</button>
          <button type="button" id="models-collapse" class="eco-btn eco-btn-secondary eco-btn-sm">Close every provider</button>
        </div>
        <p class="models-search-status" id="models-search-status" role="status">Providers are closed. Open one, or search to look across all {records.length} models.</p>
      </div>
      ) : null}
    </header>

    {!hasRecords ? (
      <section class="eco-panel models-unavailable">
        <h2>Model data is unavailable</h2>
        <p>
          Data exports: <a href="/api/models.json">models.json</a> and{" "}
          <a href="/llms-full.txt">llms-full.txt</a>.
        </p>
      </section>
    ) : null}

    {hasRecords ? <div class="models-groups">{providers.map((group) => {
      const mark = providerIcon(group.provider);
      return (
      <details class="eco-panel models-group" id={group.id} data-provider={group.provider.toLowerCase()}>
        <summary>
          {mark
            ? <img class:list={["models-group-mark", { "is-mono": mark.mono }]} src={mark.src} alt="" width="18" height="18" loading="lazy" decoding="async" />
            : <span class="models-group-mark models-group-mark-empty" aria-hidden="true"></span>}
          <h2 id={`${group.id}-heading`}>{group.provider}</h2>
          <span class="models-group-meta">
            <span data-provider-count>{group.models.length} {group.models.length === 1 ? "model" : "models"}</span>
            {group.indexRange ? <span data-provider-range> · AA Index {group.indexRange}</span> : null}
          </span>
          <span class="models-group-hint" aria-hidden="true"></span>
        </summary>
        <p class="models-group-note">Ordered by AA Index where one is published. This describes the data, it does not recommend a model.</p>
        <div class="models-table-wrap">
          <table class="models-table">
            <thead>
              <tr>
                <th scope="col">Model</th>
                <th scope="col" class="num">AA Index</th>
                <th scope="col" class="num">Input $/1M</th>
                <th scope="col" class="num">Output $/1M</th>
                <th scope="col" class="num">Tokens/s</th>
                <th scope="col" class="num">Context</th>
                <th scope="col">Last observed</th>
              </tr>
            </thead>
            <tbody>
              {group.models.map((record) => (
                <tr
                  data-index={raw(get(record.indexes, "aa_intelligence_index"))}
                  data-input={raw(get(record.pricing, "price_1m_input_tokens"))}
                  data-output={raw(get(record.pricing, "price_1m_output_tokens"))}
                  data-speed={raw(get(record.speed, "median_output_tokens_per_second"))}
                  data-context={raw(get(record.context, "openrouter_context_length"))}
                >
                  <th scope="row"><a href={record.path}>{record.name}</a></th>
                  <td class="num">{points(get(record.indexes, "aa_intelligence_index"))}</td>
                  <td class="num">{money(get(record.pricing, "price_1m_input_tokens"))}</td>
                  <td class="num">{money(get(record.pricing, "price_1m_output_tokens"))}</td>
                  <td class="num">{tps(get(record.speed, "median_output_tokens_per_second"))}</td>
                  <td class="num">{ctx(get(record.context, "openrouter_context_length"))}</td>
                  <td>{record.lastSeenDate ?? "n/a"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
      );
    })}</div> : null}

    {hasRecords ? (
      <section class="models-flat" id="models-flat" aria-labelledby="models-flat-heading" hidden>
        <h2 id="models-flat-heading" class="sr-only">All models in one table</h2>
        <p class="models-group-note" id="models-flat-note">Every model in one table. Choose a column to sort; models without that value stay at the bottom either way.</p>
        <div class="models-table-wrap">
          <table class="models-table models-flat-table" aria-describedby="models-flat-note">
            <thead>
              <tr>
                <th scope="col">Model</th>
                <th scope="col">Lab</th>
                <th scope="col" class="num" data-sort="index" aria-sort="descending"><button type="button">AA Index</button></th>
                <th scope="col" class="num" data-sort="input"><button type="button">Input $/1M</button></th>
                <th scope="col" class="num" data-sort="output"><button type="button">Output $/1M</button></th>
                <th scope="col" class="num" data-sort="speed"><button type="button">Tokens/s</button></th>
                <th scope="col" class="num" data-sort="context"><button type="button">Context</button></th>
                <th scope="col">Last observed</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </section>
    ) : null}
  </main>

  <script>
    import { searchDirectoryGroups, providerIdFromHash } from "../../lib/model-directory-search";
    import { defaultDirection, parseSortValue, sortByMeasure, type ModelSortKey, type SortDirection } from "../../components/models/model-table-sort";
    // Progressive enhancement: the page works with every provider closed and
    // opened by click. With JavaScript the search filters rows across all
    // providers and opens only the sections that still have a match.
    const find = document.getElementById("models-find");
    const input = document.getElementById("models-search-input") as HTMLInputElement | null;
    const status = document.getElementById("models-search-status");
    const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>(".models-group"));
    if (find && input && status && groups.length) {
      find.hidden = false;
      const rows = groups.map((group) => ({
        group,
        provider: group.dataset.provider ?? "",
        countLabel: group.querySelector<HTMLElement>("[data-provider-count]"),
        rangeLabel: group.querySelector<HTMLElement>("[data-provider-range]"),
        items: Array.from(group.querySelectorAll<HTMLTableRowElement>("tbody tr")).map((row) => ({
          row,
          name: (row.querySelector("th a")?.textContent ?? "").toLowerCase(),
        })),
      }));
      const closedMessage = status.textContent ?? "";

      // One table across every lab, built from the same server-rendered rows.
      const flat = document.getElementById("models-flat");
      const flatBody = flat?.querySelector("tbody") ?? null;
      const groupsWrap = document.querySelector<HTMLElement>(".models-groups");
      const viewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".models-view button"));
      const expandButton = document.getElementById("models-expand") as HTMLButtonElement | null;
      const collapseButton = document.getElementById("models-collapse") as HTMLButtonElement | null;
      const sortLabels: Record<ModelSortKey, string> = { index: "AA Index", input: "input price", output: "output price", speed: "output speed", context: "context length" };
      let view: "labs" | "table" = "labs";
      let sortKey: ModelSortKey = "index";
      let sortDirection: SortDirection = "desc";
      type FlatRow = { row: HTMLTableRowElement; provider: string; name: string };
      let flatRows: FlatRow[] = [];
      const buildFlat = () => {
        if (!flatBody || flatRows.length) return;
        for (const entry of rows) {
          const label = entry.group.querySelector("summary h2")?.textContent ?? entry.provider;
          for (const item of entry.items) {
            const row = item.row.cloneNode(true) as HTMLTableRowElement;
            row.hidden = false;
            const lab = document.createElement("td");
            lab.className = "models-flat-lab";
            lab.textContent = label;
            row.querySelector("th")?.after(lab);
            flatRows.push({ row, provider: entry.provider, name: item.name });
          }
        }
      };
      const sortFlat = () => {
        if (!flatBody) return;
        flatRows = sortByMeasure(flatRows, (entry) => parseSortValue(entry.row.dataset[sortKey]), sortDirection);
        flatBody.replaceChildren(...flatRows.map((entry) => entry.row));
        flat?.querySelectorAll<HTMLTableCellElement>("th[data-sort]").forEach((cell) => {
          if (cell.dataset.sort === sortKey) cell.setAttribute("aria-sort", sortDirection === "asc" ? "ascending" : "descending");
          else cell.removeAttribute("aria-sort");
        });
      };
      const flatStatus = (matches: number | null) =>
        matches === null
          ? `${flatRows.length} models in one table, sorted by ${sortLabels[sortKey]}, ${sortDirection === "asc" ? "lowest" : "highest"} first. Missing values are listed last.`
          : matches
            ? `${matches} ${matches === 1 ? "model matches" : "models match"}, sorted by ${sortLabels[sortKey]}.`
            : "No model or provider matches that search.";

      const apply = (raw: string) => {
        const query = raw.trim().toLowerCase();
        if (view === "table") {
          let matches = 0;
          for (const entry of flatRows) {
            const hit = !query || entry.provider.includes(query) || entry.name.includes(query);
            entry.row.hidden = !hit;
            if (hit) matches += 1;
          }
          status.textContent = flatStatus(query ? matches : null);
          return;
        }
        const results = searchDirectoryGroups(rows.map(entry=>({provider:entry.provider,names:entry.items.map(item=>item.name)})),raw);
        if (!query) {
          rows.forEach((entry,index) => {
            for (const item of entry.items) item.row.hidden = false;
            entry.group.hidden = false;
            entry.group.open = false;
            if (entry.countLabel) entry.countLabel.textContent = results[index].countText;
            if (entry.rangeLabel) entry.rangeLabel.hidden = !results[index].showRange;
          });
          status.textContent = closedMessage;
          return;
        }
        let matches = 0;
        let shownGroups = 0;
        rows.forEach((entry,index) => {
          const result=results[index];
          for (const [itemIndex,item] of entry.items.entries()) {
            const hit = result.itemMatches[itemIndex];
            item.row.hidden = !hit;
          }
          if (entry.countLabel) entry.countLabel.textContent = result.countText;
          if (entry.rangeLabel) entry.rangeLabel.hidden = !result.showRange;
          matches += result.matchCount;
          entry.group.hidden = !result.visible;
          entry.group.open = result.matchCount > 0;
          if (result.matchCount > 0) shownGroups += 1;
        });
        status.textContent = matches
          ? `${matches} ${matches === 1 ? "model" : "models"} across ${shownGroups} ${shownGroups === 1 ? "provider" : "providers"}.`
          : "No model or provider matches that search.";
      };

      let frame = 0;
      input.addEventListener("input", () => {
        window.cancelAnimationFrame(frame);
        frame = window.requestAnimationFrame(() => apply(input.value));
      });

      const setView = (next: "labs" | "table") => {
        view = next;
        if (next === "table") { buildFlat(); sortFlat(); }
        if (flat) flat.hidden = next !== "table";
        if (groupsWrap) groupsWrap.hidden = next === "table";
        if (expandButton) expandButton.disabled = next === "table";
        if (collapseButton) collapseButton.disabled = next === "table";
        for (const button of viewButtons) button.setAttribute("aria-pressed", String(button.dataset.view === next));
        try { window.localStorage.setItem("models-view", next); } catch { /* storage unavailable */ }
        apply(input.value);
      };
      for (const button of viewButtons) {
        button.addEventListener("click", () => setView(button.dataset.view === "table" ? "table" : "labs"));
      }
      flat?.querySelectorAll<HTMLTableCellElement>("th[data-sort]").forEach((cell) => {
        cell.querySelector("button")?.addEventListener("click", () => {
          const key = cell.dataset.sort as ModelSortKey;
          sortDirection = key === sortKey ? (sortDirection === "asc" ? "desc" : "asc") : defaultDirection(key);
          sortKey = key;
          sortFlat();
          apply(input.value);
        });
      });

      document.getElementById("models-expand")?.addEventListener("click", () => {
        for (const entry of rows) if (!entry.group.hidden) entry.group.open = true;
      });
      document.getElementById("models-collapse")?.addEventListener("click", () => {
        for (const entry of rows) entry.group.open = false;
      });

      // A link to #provider must reveal that provider, not just scroll to a closed row.
      const openFromHash = () => {
        const id = providerIdFromHash(window.location.hash);
        if (!id) return;
        const target = document.getElementById(id);
        if (target instanceof HTMLDetailsElement) {
          if (view === "table") setView("labs");
          target.open = true;
          target.scrollIntoView({ block: "start" });
        }
      };
      window.addEventListener("hashchange", openFromHash);
      let savedView: string | null = null;
      try { savedView = window.localStorage.getItem("models-view"); } catch { /* storage unavailable */ }
      // A link to one provider always opens the per-lab list.
      if (savedView === "table" && !providerIdFromHash(window.location.hash)) setView("table");
      openFromHash();
    }
  </script>

  <Footer />
  <ScrollToTop />
</Layout>

<style is:global>
  .models-index { padding-block: var(--space-6) var(--space-8); display: grid; gap: var(--space-5); }
  .models-hero { display: grid; gap: var(--space-3); max-width: 64rem; }
  .models-hero h1 { font-size: var(--text-3xl); font-weight: 700; letter-spacing: -0.02em; line-height: var(--leading-tight); color: var(--ink-0); margin: 0; }
  .models-lead { color: var(--ink-1); max-width: 64ch; margin: 0; line-height: var(--leading-relaxed); }
  .models-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); margin: var(--space-2) 0 0; }
  .models-facts div { padding: var(--space-3) var(--space-4); display: grid; gap: var(--space-1); }
  .models-facts dt { font-size: var(--text-xs); color: var(--ink-2); }
  .models-facts dd { margin: 0; font-family: var(--font-mono); font-size: var(--text-sm); color: var(--ink-0); }
  .models-facts a { color: var(--signal-text); }
  .models-find { display: grid; gap: var(--space-3); grid-template-columns: minmax(0, 1fr) auto; align-items: end; }
  .models-search { display: grid; gap: var(--space-1); }
  .models-search input {
    width: 100%;
    min-height: var(--control-h);
    padding: 0 var(--space-3);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-sm);
    background: var(--surface-1);
    color: var(--ink-0);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }
  .models-search input:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-color: var(--signal); }
  .models-find-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .models-search-status { grid-column: 1 / -1; margin: 0; color: var(--ink-2); font-size: var(--text-xs); }
  .models-group { display: grid; grid-template-columns: minmax(0, 1fr); min-width: 0; gap: var(--space-3); scroll-margin-top: calc(var(--header-h) + var(--space-3)); }
  .models-group > summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 1rem;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    cursor: pointer;
    list-style: none;
    padding: var(--space-3);
  }
  .models-group > summary::-webkit-details-marker { display: none; }
  .models-group > summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
  .models-group > summary h2 { min-width: 0; overflow-wrap: anywhere; margin: 0; font-size: var(--text-lg); font-weight: 600; color: var(--ink-0); }
  .models-group-meta { min-width: 0; overflow-wrap: anywhere; color: var(--ink-2); font-family: var(--font-mono); font-size: var(--text-xs); }
  .models-group-hint {
    grid-column: 3;
    grid-row: 1 / 3;
    justify-self: center;
    align-self: center;
    width: 0.6rem;
    height: 0.6rem;
    border-right: 2px solid var(--ink-2);
    border-bottom: 2px solid var(--ink-2);
    transform: rotate(45deg) translate(-0.15rem, -0.15rem);
    transition: transform var(--dur-fast) var(--ease-standard);
  }
  .models-group[open] > summary .models-group-hint { transform: rotate(225deg) translate(-0.1rem, -0.1rem); }
  .models-group > summary:hover h2 { color: var(--signal-text); }
  .models-group-note { margin: 0; color: var(--ink-2); font-size: var(--text-xs); }
  .models-unavailable { padding: var(--space-5); display: grid; gap: var(--space-3); }
  .models-unavailable h2 { margin: 0; font-size: var(--text-lg); font-weight: 600; color: var(--ink-0); }
  .models-unavailable p { margin: 0; color: var(--ink-1); max-width: 64ch; line-height: var(--leading-relaxed); }
  .models-unavailable a { color: var(--signal-text); }
  @media (max-width: 640px) {
    .models-find { grid-template-columns: minmax(0, 1fr); }
    .models-group > summary { grid-template-columns: minmax(0, 1fr) 0 1rem; gap: .35rem .5rem; }
    .models-group > summary h2 { grid-column: 1; grid-row: 1; }
    .models-group-meta { grid-column: 1; grid-row: 2; }
  }
  .models-table-wrap { min-width: 0; max-width: 100%; overflow-x: auto; }
  .models-table { width: 100%; min-width: 44rem; border-collapse: collapse; font-size: var(--text-sm); }
  .models-table th, .models-table td { padding: var(--space-2) var(--space-3); border-top: 1px solid var(--line-0); text-align: left; vertical-align: top; }
  .models-table thead th { border-top: 0; font-size: var(--text-xs); color: var(--ink-2); font-weight: 500; }
  .models-table tbody th { font-weight: 500; }
  .models-table tbody th a { color: var(--ink-0); text-decoration: none; }
  .models-table tbody th a:hover { color: var(--signal-text); text-decoration: underline; }
  .models-table .num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
  .models-table td:last-child { font-family: var(--font-mono); color: var(--ink-2); font-size: var(--text-xs); white-space: nowrap; }

  /* Polish layer: a quieter header and one joined provider list instead of separate panels. */
