---
// Layout.astro: shared document shell for every page.
import { ClientRouter } from "astro:transitions";
import "../styles/tailwind.css";
import ModelDrawer from "./ModelDrawer";
import { STATIC_PAGE_DATE_MODIFIED } from "../lib/site-pages";
import { AUTHOR_PERSON, AUTHOR_REF } from "../lib/author";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  noindex?: boolean;
  robots?: string;
  dateModified?: string;
}

const siteName = "AI Stats";
const siteAuthor = AUTHOR_PERSON.name;

const {
  title = "AI Stats | AI model stats, LLM ranking & benchmarks by Jonathan R. Reed",
  description = "Compare AI model pricing, benchmark scores, context limits, and speed. Public data covering OpenAI, Anthropic, Google, Meta, and other model providers.",
  image = "/social-card.png",
  ogType = "website",
  noindex = false,
  robots,
  // Static pages keep the last editorial revision date; data-driven pages pass
  // the real refresh date from src/lib/data-freshness.ts.
  dateModified = STATIC_PAGE_DATE_MODIFIED,
} = Astro.props;

const canonicalPathname = Astro.url.pathname
  .replace(/\/index\.html$/, "/")
  .replace(/\.html$/, "");
const canonicalURL = new URL(canonicalPathname, Astro.site).href;
const ogImageURL = new URL(image, Astro.site).href;
const robotsContent =
  robots ?? (noindex ? "noindex, nofollow" : "index, follow");
const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${Astro.site?.href || canonicalURL}#website`,
      name: siteName,
      description:
        "Compare AI model pricing, performance benchmarks, and technical specifications",
      url: Astro.site?.href || canonicalURL,
      author: AUTHOR_REF,
      publisher: AUTHOR_REF,
    },
    AUTHOR_PERSON,
    {
      "@type": "WebPage",
      "@id": `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: title,
      description,
      isPartOf: {
        "@id": `${Astro.site?.href || canonicalURL}#website`,
      },
      author: AUTHOR_REF,
      datePublished: "2026-04-21",
      dateModified,
      inLanguage: "en-US",
    },
  ],
};
---

<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    {image === "/jonathan.avif" && (
      <link rel="preload" href="/jonathan.avif" as="image" fetchpriority="high" />
    )}

    <!-- Theme boots before paint so neither theme flashes. -->
    <script is:inline src="/site-theme.js"></script>

    <!-- Ecosystem type, self-hosted -->
    <link rel="preload" href="/fonts/nebula-sans/NebulaSans-Book.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/nebula-sans/NebulaSans-Semibold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono/JetBrainsMono-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robotsContent} />
    <meta name="author" content={siteAuthor} />
    <meta name="theme-color" content="#090b0d" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:creator" content="@jonathanrayreed" />

    <!-- Structured Data (JSON-LD) -->
    <!-- SoftwareApplication schema intentionally omitted to avoid invalid review/rating rich-result requirements. -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />

    <ClientRouter />

    <style is:global>
      /* Evidence colors: score tiers read as state, never as decoration. */
      .score-high { color: var(--ok); }
      .score-mid { color: var(--warn); }
      .score-low { color: var(--warn); }
      .score-poor { color: var(--bad); }
      .score-none { color: var(--ink-2); }

      .score-bg-high,
      .score-bg-mid,
      .score-bg-low,
      .score-bg-poor,
      .score-bg-none {
        color: var(--ink-0);
        border: 1px solid var(--line-1);
        border-radius: var(--radius-sm);
      }
      .score-bg-high { background: var(--ok-soft); border-color: color-mix(in srgb, var(--ok) 45%, transparent); }
      .score-bg-mid { background: var(--warn-soft); border-color: color-mix(in srgb, var(--warn) 45%, transparent); }
      .score-bg-low { background: var(--warn-soft); border-color: color-mix(in srgb, var(--warn) 30%, transparent); }
      .score-bg-poor { background: var(--bad-soft); border-color: color-mix(in srgb, var(--bad) 45%, transparent); }
      .score-bg-none { background: var(--surface-2); }

      /* Provider logos */
      .provider-logo-frame {
        width: 1.8rem;
        height: 1.8rem;
        display: inline-flex;
        flex: 0 0 1.8rem;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--line-1);
        border-radius: var(--radius-md);
        background: var(--surface-2);
      }
      .provider-logo-frame-light { background: #f6f3ea; border-color: rgba(0, 0, 0, 0.12); }
      .provider-logo-image { width: 1.05rem; height: 1.05rem; object-fit: contain; display: block; }
      .provider-logo-fallback { color: var(--ink-1); font-family: var(--font-mono); font-size: 0.62rem; font-weight: 600; }
      .provider-logo-dark { padding: 3px; background: #f6f3ea; border: 1px solid rgba(0, 0, 0, 0.12); border-radius: var(--radius-sm); }

      .container {
        max-width: var(--container);
        margin-inline: auto;
        padding-inline: var(--gutter);
        width: 100%;
      }

      #root, main, section { min-width: 0; }
      .no-overflow-x { overflow-x: hidden; }

      /* Panels and primary action. Class names predate the contract and stay for the scripts that use them. */
      .brutalist-card {
        background: var(--surface-1);
        border: 1px solid var(--line-0);
        border-radius: var(--radius-md);
        transition: border-color var(--dur-base) var(--ease-standard);
      }
      .brutalist-card:hover,
      .brutalist-card:focus-within { border-color: var(--line-1); }

      .brutalist-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        min-height: var(--control-h);
        padding: 0 var(--space-4);
        background: var(--signal);
        color: var(--signal-ink);
        border: 1px solid var(--signal);
        border-radius: var(--radius-md);
        font-family: var(--font-sans);
        font-size: var(--text-sm);
        font-weight: 600;
        line-height: 1;
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
        transition: background-color var(--dur-fast) var(--ease-standard), border-color var(--dur-fast) var(--ease-standard);
      }
      .brutalist-button:hover { background: var(--signal-hover); border-color: var(--signal-hover); }
      .brutalist-button.secondary {
        background: transparent;
        color: var(--ink-0);
        border-color: var(--line-1);
      }
      .brutalist-button.secondary:hover { background: var(--surface-2); border-color: var(--ink-2); }

      /* Reveal on scroll: progressive enhancement, one quiet fade. */
      .fade-in-section,
      .stagger-item { opacity: 1; transform: none; }
      html.motion-ready .fade-in-section,
      html.motion-ready .stagger-item {
        opacity: 0;
        transform: translateY(6px);
        transition: opacity var(--dur-slow) var(--ease-out), transform var(--dur-slow) var(--ease-out);
      }
      html.motion-ready .fade-in-section.is-visible,
      html.motion-ready .stagger-item.is-visible { opacity: 1; transform: none; }

      @media (prefers-reduced-motion: no-preference) {
        ::view-transition-old(root),
        ::view-transition-new(root) { animation-duration: 0.2s; }
      }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) { animation: none; }
        .fade-in-section,
        .stagger-item { opacity: 1; transform: none; transition: none; }
      }
    </style>
    <slot name="head" />
  </head>
  <body>
    <!--
    THESIS: AI Stats organizes source-backed model evidence without presenting an opaque universal ranking or recommendation.
    OWN-WORLD: Measurement black, warm paper ink, one copper signal, blue-gray plots, mono readouts, hairline structure. Ecosystem contract v1.
    STORY: Select an evidence lens and price ceiling, inspect comparable models, understand the formula and missing fields, then explore source health and native benchmark tradeoffs.
    -->
    <slot />
    <ModelDrawer client:idle />

    <script is:inline src="/page-motion.js" defer></script>
  </body>
</html>
