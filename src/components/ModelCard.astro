---
import {
  formatScore,
  formatIndex,
  formatPrice,
  formatTPS,
  formatTTFT,
} from "../lib/format-utils";

interface Props {
  model: any;
}

const { model } = Astro.props;

// Provider logo mapping
const providerLogos: Record<string, string> = {
  openai: "/icons/providers/openai.svg",
  anthropic: "/icons/providers/anthropic.svg",
  claude: "/icons/providers/claude-color.svg",
  google: "/icons/providers/google.svg",
  gemini: "/icons/providers/gemini-color.svg",
  gemma: "/icons/providers/gemma-color.svg",
  meta: "/icons/providers/meta.svg",
  llama: "/icons/providers/meta.svg",
  mistral: "/icons/providers/mistral.svg",
  cohere: "/icons/providers/cohere-color.svg",
  deepseek: "/icons/providers/deepseek-color.svg",
  qwen: "/icons/providers/qwen-color.svg",
  alibaba: "/icons/providers/qwen-color.svg",
  xai: "/icons/providers/xai.svg",
  grok: "/icons/providers/grok.svg",
  nvidia: "/icons/providers/nvidia-color.svg",
  microsoft: "/icons/providers/microsoft.svg",
  moonshot: "/icons/providers/moonshot.svg",
  kimi: "/icons/providers/moonshot.svg",
  perplexity: "/icons/providers/perplexity.svg",
  bytedance: "/icons/providers/bytedance.svg",
  minimax: "/icons/providers/minimax.svg",
  zhipu: "/icons/providers/zai.svg",
  zai: "/icons/providers/zai.svg",
};

// Logos that are dark/black and need a light background in dark mode
const darkLogos = [
  "openai",
  "anthropic",
  "xai",
  "grok",
  "moonshot",
  "kimi",
  "zai",
  "zhipu",
  "meta",
  "llama",
  "perplexity",
  "bytedance",
];

const companyLower = (model.company_name ?? "").toLowerCase();
const modelNameLower = (model.name ?? "").toLowerCase();
const searchStr = `${companyLower} ${modelNameLower}`;
const normalizedSearchStr = searchStr.replace(/[^a-z0-9]+/g, "");
const matchedProvider = Object.entries(providerLogos).find(([key]) =>
  normalizedSearchStr.includes(key.replace(/[^a-z0-9]+/g, "")),
);
const providerLogo = matchedProvider?.[1];
const isDarkLogo = matchedProvider
  ? darkLogos.some((d) => normalizedSearchStr.includes(d.replace(/[^a-z0-9]+/g, "")))
  : false;
const providerName = model.company_name ?? "Unknown provider";
const providerInitials = providerName
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part: string) => part[0]?.toUpperCase())
  .join("") || "?";

// Get score color based on value (0-100 scale)
function getScoreColor(score: number | null | undefined): string {
  if (!score || score <= 0) return "score-none";
  const pct = score <= 1 ? score * 100 : score;
  if (pct >= 80) return "score-high";
  if (pct >= 60) return "score-mid";
  if (pct >= 40) return "score-low";
  return "score-poor";
}

function getScoreBg(score: number | null | undefined): string {
  if (!score || score <= 0) return "score-bg-none";
  const pct = score <= 1 ? score * 100 : score;
  if (pct >= 80) return "score-bg-high";
  if (pct >= 60) return "score-bg-mid";
  if (pct >= 40) return "score-bg-low";
  return "score-bg-poor";
}

// All benchmarks
const allBenchmarks = [
  ["MMLU Pro", model.mmlu_pro],
  ["GPQA", model.gpqa],
  ["HLE", model.hle],
  ["AIME", model.aime],
  ["LiveCodeBench", model.livecodebench],
  ["SciCode", model.scicode],
  ["Math 500", model.math_500],
];

// AA Indexes
const aaIndexes = [
  ["AA Index", model.aa_intelligence_index],
  ["Coding", model.aa_coding_index],
  ["Math", model.aa_math_index],
];

const formatContextLength = (value: number | null | undefined): string => {
  const num = Number(value);
  if (!Number.isFinite(num) || num <= 0) return "-";
  if (num >= 1_000_000) {
    return `${(num / 1_000_000).toFixed(num % 1_000_000 === 0 ? 0 : 1)}M`;
  }
  if (num >= 1_000) return `${Math.round(num / 1_000)}K`;
  return String(num);
};

const openRouterParameters = Array.isArray(model.openrouter_supported_parameters)
  ? model.openrouter_supported_parameters
  : [];
const openRouterInputModalities = Array.isArray(model.openrouter_input_modalities)
  ? model.openrouter_input_modalities
  : [];
const openRouterOutputModalities = Array.isArray(model.openrouter_output_modalities)
  ? model.openrouter_output_modalities
  : [];
const hasOpenRouterData = Boolean(model.openrouter_id);
const hasHuggingFaceData = Boolean(model.hf_model_id);
const hasLiteLlmData = Boolean(model.litellm_model_id);
const openRouterCaps = [
  openRouterParameters.includes("tools") || model.litellm_supports_function_calling
    ? "Tools"
    : null,
  openRouterInputModalities.includes("image") || model.litellm_supports_vision
    ? "Vision"
    : null,
  openRouterOutputModalities.includes("image") ? "Image out" : null,
  model.litellm_supports_reasoning ? "Reasoning" : null,
  model.litellm_supports_prompt_caching ? "Cache" : null,
  model.litellm_supports_web_search ? "Web" : null,
]
  .filter(Boolean)
  .join(", ");
const hasPositiveNumber = (value: number | null | undefined): boolean => {
  const num = Number(value);
  return Number.isFinite(num) && num > 0;
};
const pricesAreClose = (
  first: number | null | undefined,
  second: number | null | undefined,
): boolean => {
  if (!hasPositiveNumber(first) || !hasPositiveNumber(second)) return false;
  return Math.abs(Number(first) - Number(second)) < 0.001;
};
const hasOpenRouterPrice =
  hasPositiveNumber(model.openrouter_prompt_price_1m) ||
  hasPositiveNumber(model.openrouter_completion_price_1m);
const openRouterPriceMatchesAa =
  pricesAreClose(model.price_1m_input_tokens, model.openrouter_prompt_price_1m) &&
  pricesAreClose(model.price_1m_output_tokens, model.openrouter_completion_price_1m);
const showOpenRouterPricing = hasOpenRouterPrice && !openRouterPriceMatchesAa;
const effectiveContextLength =
  model.openrouter_context_length ||
  model.litellm_max_input_tokens ||
  model.context_window;
const publicSourceCount = [
  hasOpenRouterData,
  Number(model.openrouter_usage_tokens) > 0,
  Number(model.openrouter_endpoint_provider_count) > 0,
  hasHuggingFaceData,
  hasLiteLlmData,
].filter(Boolean).length;
const dataSourceBadge =
  publicSourceCount > 1
    ? `AA + ${publicSourceCount} catalogs`
    : hasOpenRouterData
      ? "AA + OR"
      : hasHuggingFaceData
        ? "AA + HF"
        : hasLiteLlmData
          ? "AA + LiteLLM"
          : "AA";
const formatCompactNumber = (value: number | null | undefined): string => {
  const num = Number(value);
  if (!Number.isFinite(num) || num <= 0) return "-";
  return new Intl.NumberFormat("en", {
    notation: "compact",
    maximumFractionDigits: 1,
  }).format(num);
};
---

<div
  data-model-card
  data-model-id={model.id}
  data-name={(model.name ?? "").toLowerCase()}
  data-company={(model.company_name ?? "").toLowerCase()}
  data-mmlu={Number(model.mmlu_pro) || 0}
  data-gpqa={Number(model.gpqa) || 0}
  data-hle={Number(model.hle) || 0}
  data-aime={Number(model.aime) || 0}
  data-input-price={Number(model.price_1m_input_tokens) || 0}
  data-output-price={Number(model.price_1m_output_tokens) || 0}
  data-tps={Number(model.median_output_tokens_per_second) || 0}
  class="model-card brutalist-card group px-4 py-4 text-sm stagger-item"
>
  <header class="flex items-start justify-between gap-2">
    <div class="flex items-center gap-2 min-w-0">
      {
        providerLogo ? (
          <span class={`provider-logo-frame ${isDarkLogo ? "provider-logo-frame-light" : ""}`}>
            <img
              src={providerLogo}
              alt={`${providerName} logo`}
              width="20"
              height="20"
              class="provider-logo-image"
              loading="lazy"
            />
          </span>
        ) : (
          <span class="provider-logo-frame provider-logo-fallback" aria-hidden="true">
            {providerInitials}
          </span>
        )
      }
      <div class="min-w-0">
        <h3
          class="break-words text-sm font-semibold text-text"
        >
          {model.name}
        </h3>
        <p class="mt-0.5 text-xs tsub">
          {providerName}
        </p>
      </div>
    </div>
    <div class="source-strip flex-shrink-0">
      <span>{dataSourceBadge}</span>
    </div>
  </header>

  <div class="mcg">
    <section class="mcp">
      <div class="mcap">
        Pricing
      </div>
      <dl class="mdl">
        <div class="mj">
          <dt>Input (1M)</dt>
          <dd class="fb">
            {formatPrice(Number(model.price_1m_input_tokens) || 0, 3)}
          </dd>
        </div>
        <div class="mj">
          <dt>Output (1M)</dt>
          <dd class="fb">
            {formatPrice(Number(model.price_1m_output_tokens) || 0, 3)}
          </dd>
        </div>
        <div class="mj">
          <dt>Blended (3:1)</dt>
          <dd class="fb">
            {formatPrice(Number(model.price_1m_blended_3_to_1) || 0, 3)}
          </dd>
        </div>
      </dl>
    </section>

    <section class="mcp">
      <div class="mcap">
        Performance
      </div>
      <dl class="mdl">
        <div class="mj">
          <dt>Tokens / s</dt>
          <dd class="fb">
            {formatTPS(model.median_output_tokens_per_second)}
          </dd>
        </div>
        <div class="mj">
          <dt>First token</dt>
          <dd class="fb">
            {formatTTFT(model.median_time_to_first_token_seconds)}
          </dd>
        </div>
        <div class="mj">
          <dt>First answer token</dt>
          <dd class="fb">
            {formatTTFT(model.median_time_to_first_answer_token)}
          </dd>
        </div>
      </dl>
    </section>

    <section class="mcp">
      <div class="mcap">
        Specs
      </div>
      <dl class="mdl">
        <div class="mj">
          <dt>Context</dt>
          <dd class="fb">
            {formatContextLength(effectiveContextLength)}
          </dd>
        </div>
        <div class="mj">
          <dt>Max output</dt>
          <dd class="fb">
            {formatContextLength(model.max_output_tokens)}
          </dd>
        </div>
        <div class="mj">
          <dt>Source</dt>
          <dd class="fb">
            {dataSourceBadge}
          </dd>
        </div>
      </dl>
    </section>
  </div>

  {
    hasOpenRouterData || hasHuggingFaceData || hasLiteLlmData ? (
      <section class="mcp2">
        <div class="mcap">Public catalog</div>
        <dl class="mdl2">
          <div class="mj2">
            <dt class="tsub">Tools</dt>
            <dd class="fb">
              {openRouterParameters.includes("tools") || model.litellm_supports_function_calling ? "Yes" : "No"}
            </dd>
          </div>
          <div class="mj2">
            <dt class="tsub">Route</dt>
            <dd class="fb">
              {hasOpenRouterData ? (model.openrouter_is_free ? "Free" : "Paid") : "-"}
            </dd>
          </div>
          {
            showOpenRouterPricing ? (
              <>
                <div class="mj2">
                  <dt class="tsub">OR input</dt>
                  <dd class="fb">
                    {formatPrice(model.openrouter_prompt_price_1m, 3)}
                  </dd>
                </div>
                <div class="mj2">
                  <dt class="tsub">OR output</dt>
                  <dd class="fb">
                    {formatPrice(model.openrouter_completion_price_1m, 3)}
                  </dd>
                </div>
              </>
            ) : null
          }
          <div class="mj3">
            <dt class="tsub">Hugging Face activity</dt>
            <dd class="mtr">
              {hasHuggingFaceData
                ? `${formatCompactNumber(model.hf_downloads)} downloads, ${formatCompactNumber(model.hf_likes)} likes`
                : "-"}
            </dd>
          </div>
          <div class="mj3">
            <dt class="tsub">OR usage</dt>
            <dd class="mtr">
              {
                Number(model.openrouter_usage_tokens) > 0
                  ? `${formatCompactNumber(model.openrouter_usage_tokens)} tokens, ${formatCompactNumber(model.openrouter_usage_requests)} req`
                  : "-"
              }
            </dd>
          </div>
          <div class="mj3">
            <dt class="tsub">OR routes</dt>
            <dd class="mtr">
              {
                Number(model.openrouter_endpoint_provider_count) > 0
                  ? `${model.openrouter_endpoint_provider_count} providers`
                  : "-"
              }
            </dd>
          </div>
          <div class="mj3">
            <dt class="tsub">Context</dt>
            <dd class="mtr">
              {formatContextLength(effectiveContextLength)}
            </dd>
          </div>
          <div class="mj3">
            <dt class="tsub">Capabilities</dt>
            <dd class="mtr">
              {openRouterCaps || "Text"}
            </dd>
          </div>
        </dl>
      </section>
    ) : null
  }

  <!-- All Benchmarks -->
  <section
    class="mcp2"
  >
    <div class="mcap">
      Benchmarks
    </div>
    <div class="mdl3">
      {
        allBenchmarks.map(([label, value]) => (
          <div class="mj">
            <span class="tsub">{label}</span>
            <span class={`font-semibold ${getScoreColor(value as number)}`}>
              {formatScore(value as number)}
            </span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- AA Indexes -->
  <section
    class="mcp2"
  >
    <div class="mcap">
      Artificial Analysis indexes (points)
    </div>
    <div class="mdl4">
      {
        aaIndexes.map(([label, value]) => (
          <div
            class={`border px-1.5 py-1.5 text-center ${getScoreBg(value as number)}`}
          >
            <div class="text-[0.65rem] text-muted">
              {label}
            </div>
            <div class={`text-xs fb ${getScoreColor(value as number)}`}>
              {formatIndex(value as number)}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</div>

<style is:global>
  .model-card {
    transition: border-color var(--dur-fast) var(--ease-standard), background-color var(--dur-fast) var(--ease-standard);
  }

  .model-card:hover,
  .model-card:focus-visible {
    border-color: var(--line-1);
    background: var(--surface-2);
  }

  .model-card:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .source-strip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-0);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    min-height: 1.6rem;
    padding: 0.2rem 0.5rem;
    color: var(--ink-1);
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
  }

  .tsub {
    color: var(--ink-2);
  }

  .fb {
    font-family: var(--font-mono);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--ink-0);
  }

  .mj,
  .mj2,
  .mj3 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .mj3 {
    grid-column: span 2 / span 2;
  }

  .mtr {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--ink-0);
  }

  .mcg {
    margin-top: var(--space-3);
    display: grid;
    gap: var(--space-2);
    color: var(--ink-1);
    font-size: var(--text-xs);
  }

  @media (min-width: 640px) {
    .mcg {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .mcg {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .mcp,
  .mcp2,
  .card-metric-panel {
    border: 1px solid var(--line-0);
    border-radius: var(--radius-sm);
    background: var(--surface-0);
  }

  .mcp,
  .mcp2 {
    padding: var(--space-2) var(--space-3);
  }

  .mcp2 {
    margin-top: var(--space-2);
  }

  .mcap {
    color: var(--ink-2);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .mdl,
  .mdl2,
  .mdl3,
  .mdl4 {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
  }

  .mdl,
  .mdl2 {
    color: var(--ink-0);
  }

  .mdl > * + * {
    margin-top: 0.125rem;
  }

  .mdl2,
  .mdl3 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-4);
    row-gap: var(--space-1);
  }

  .mdl4 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-1);
  }

  /* Hide default details marker */
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
