---
interface Props {
  currentPage?: string;
}

const { currentPage = "dashboard" } = Astro.props;
const links = [
  { href: "/", label: "Stats", key: "dashboard" },
  { href: "/compare", label: "Compare", key: "compare" },
  { href: "/models", label: "Models", key: "models" },
  { href: "/about", label: "About", key: "about" },
  { href: "/contact", label: "Contact", key: "contact" },
];
---

<a href="#main-content" class="eco-skip">Skip to content</a>
<header class="header eco-header">
  <div class="eco-container eco-header-inner header-container">
    <a href="/" class="eco-lockup logo-link" aria-label="AI Stats home">
      <svg class="eco-mark" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6.5 3.5H3.5v17h3" fill="none" stroke="var(--signal)" stroke-width="2" stroke-linecap="square" />
        <path d="M17.5 3.5h3v17h-3" fill="none" stroke="var(--signal)" stroke-width="2" stroke-linecap="square" />
        <rect x="9" y="6" width="6" height="2.4" fill="var(--ink-1)" />
        <rect x="9" y="10.8" width="6" height="2.4" fill="var(--signal)" />
        <rect x="9" y="15.6" width="6" height="2.4" fill="var(--ink-1)" />
      </svg>
      <span class="eco-wordmark">AI Stats</span>
    </a>

    <nav class="eco-nav desktop-nav" aria-label="Primary">
      {links.map((link) => (
        <a
          href={link.href}
          class="eco-nav-link nav-item"
          aria-current={currentPage === link.key ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
      <button id="theme-toggle" class="eco-icon-btn eco-theme-toggle theme-toggle" type="button" aria-label="Toggle light and dark theme" title="Toggle light and dark theme">
        <svg class="eco-icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
        </svg>
        <svg class="eco-icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
      </button>
    </nav>

    <div class="mobile-controls">
      <button id="theme-toggle-mobile" class="eco-icon-btn eco-theme-toggle theme-toggle" type="button" aria-label="Toggle light and dark theme">
        <svg class="eco-icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
        </svg>
        <svg class="eco-icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
      </button>
      <button id="mobile-menu-toggle" class="eco-icon-btn eco-menu-btn hamburger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>

  <div id="mobile-nav-overlay" class="mobile-nav-overlay" aria-hidden="true"></div>
  <nav id="mobile-nav" class="mobile-nav" inert aria-label="Mobile navigation">
    <a href="/" class="mobile-nav-item" aria-current={currentPage === "dashboard" ? "page" : undefined} tabindex="-1">Stats</a>
    <a href="/compare" class="mobile-nav-item" aria-current={currentPage === "compare" ? "page" : undefined} tabindex="-1">Compare</a>
    <a href="/models" class="mobile-nav-item" aria-current={currentPage === "models" ? "page" : undefined} tabindex="-1">Models</a>
    <a href="/about" class="mobile-nav-item" aria-current={currentPage === "about" ? "page" : undefined} tabindex="-1">About</a>
    <a href="/contact" class="mobile-nav-item" aria-current={currentPage === "contact" ? "page" : undefined} tabindex="-1">Contact</a>
  </nav>
</header>

<style is:global>
  .header.scrolled {
    border-bottom-color: var(--line-1);
  }

  .header-container {
    max-width: var(--container);
  }

  .logo-link:hover .eco-wordmark {
    color: var(--ink-0);
  }

  /* Mobile controls */
  .mobile-controls {
    display: none;
    align-items: center;
    gap: var(--space-2);
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
  }

  .hamburger-line {
    width: 16px;
    height: 2px;
    background: currentColor;
    transition: transform var(--dur-base) var(--ease-standard), opacity var(--dur-base) var(--ease-standard);
  }

  .hamburger.open .hamburger-line:nth-child(1) { transform: rotate(45deg) translate(4px, 4px); }
  .hamburger.open .hamburger-line:nth-child(2) { opacity: 0; }
  .hamburger.open .hamburger-line:nth-child(3) { transform: rotate(-45deg) translate(4px, -4px); }

  .mobile-nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 998;
    background: color-mix(in srgb, var(--surface-0) 70%, transparent);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur-base) var(--ease-standard), visibility var(--dur-base) var(--ease-standard);
  }

  .mobile-nav-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav {
    position: fixed;
    top: var(--header-h);
    right: 0;
    left: 0;
    z-index: 999;
    display: none;
    padding: var(--space-2) var(--gutter) var(--space-4);
    background: var(--surface-0);
    border-bottom: 1px solid var(--line-1);
    box-shadow: var(--shadow-2);
    transform: translateY(-8px);
    opacity: 0;
    transition: transform var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-standard);
  }

  .mobile-nav.open {
    transform: none;
    opacity: 1;
  }

  .mobile-nav-item {
    display: flex;
    align-items: center;
    min-height: var(--control-h);
    padding: 0 var(--space-2);
    border-bottom: 1px solid var(--line-0);
    color: var(--ink-1);
    font-size: var(--text-base);
    font-weight: 500;
    text-decoration: none;
  }

  .mobile-nav-item:last-child { border-bottom: 0; }

  .mobile-nav-item[aria-current="page"] {
    color: var(--ink-0);
    box-shadow: inset 3px 0 0 var(--signal);
    padding-left: var(--space-3);
  }

  @media (max-width: 640px) {
    .desktop-nav {
      display: none;
    }
    .mobile-controls {
      display: flex;
      z-index: 1000;
    }
    .mobile-nav {
      display: grid;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav,
    .mobile-nav-overlay,
    .hamburger-line {
      transition: none;
    }
  }
</style>

<script is:inline src="/header.js" defer></script>
<script is:inline>
  (() => {
    const bindAccessibleMobileMenu = () => {
      const toggle = document.getElementById("mobile-menu-toggle");
      const nav = document.getElementById("mobile-nav");
      const overlay = document.getElementById("mobile-nav-overlay");
      if (!toggle || !nav || toggle.dataset.focusManaged === "true") return;
      toggle.dataset.focusManaged = "true";
      let returnFocus = toggle;

      const focusable = () => Array.from(nav.querySelectorAll('a[href]:not([tabindex="-1"])'));
      const syncFocus = () => {
        const open = toggle.getAttribute("aria-expanded") === "true";
        overlay?.setAttribute("aria-hidden", String(!open));
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        if (open) focusable()[0]?.focus();
        else returnFocus?.focus();
      };

      toggle.addEventListener("click", () => {
        returnFocus = toggle;
        window.requestAnimationFrame(syncFocus);
      });
      overlay?.addEventListener("click", () => window.requestAnimationFrame(syncFocus));
      nav.addEventListener("keydown", (event) => {
        if (event.key !== "Tab") return;
        const items = focusable();
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
          window.requestAnimationFrame(syncFocus);
        }
      });
    };
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", bindAccessibleMobileMenu);
    else bindAccessibleMobileMenu();
    document.addEventListener("astro:page-load", bindAccessibleMobileMenu);
  })();
</script>
