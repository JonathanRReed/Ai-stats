---
import {getModelCatalogData} from '../lib/model-catalog-data';
import {catalogCoverage} from '../lib/model-catalog';
const {records,unavailableSources}=await getModelCatalogData();
const coverage=catalogCoverage(records,unavailableSources);
---
<details class="catalog-coverage">
 <summary>{coverage.records.toLocaleString('en-US')} available source records</summary>
 {!coverage.complete?<p role="status">Partial catalog. Could not load: {coverage.unavailableSources.join(', ')}.</p>:null}
 <p>Source records include exact variants and provider routes, not unique model families. {coverage.historical} historical AA records are opt-in in Compare.</p>
 <ul>{coverage.sources.map(source=><li>{source.name}: {source.count.toLocaleString('en-US')}</li>)}</ul>
 <a href="/compare">Browse and compare</a> · <a href="/api/model-catalog.json">Catalog JSON</a>
</details>
<style>
.catalog-coverage{margin:14px 0;padding:12px 14px;border:1px solid var(--line-1);border-radius:4px;font-size:12px;color:var(--ink-2)}
summary{cursor:pointer;color:var(--ink-1)}p{max-width:800px;line-height:1.5}ul{display:flex;gap:8px 22px;flex-wrap:wrap;list-style:none;padding:0}a{color:var(--signal-text)}
@media(max-width:600px){summary{min-height:44px;display:flex;align-items:center}ul{display:block}li{margin:6px 0}}
</style>
