---
import {compareRecordHref} from "../lib/model-identity";
import type { AaModel } from "../lib/supabase";
import { formatIndex, formatPrice, formatTPS } from "../lib/format-utils";
import { aaEvidenceNote } from "../lib/aa-evidence";

type Props = {
  models: AaModel[];
};

const { models } = Astro.props;
const latestObserved = models
  .map((model) => new Date(model.last_seen ?? ""))
  .filter((date) => !Number.isNaN(date.getTime()))
  .sort((a, b) => b.getTime() - a.getTime())[0];

const formatTrackedDate = (value: string | null | undefined): string => {
  const date = new Date(value ?? "");
  if (Number.isNaN(date.getTime())) return "Unknown";
  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(date);
};
const providerFor = (model: AaModel): string =>
  model.company_name ?? model.creator_name ?? "Unknown provider";
---

<section class="latest-models" aria-label="Current benchmark snapshot">
  <header class="latest-models-header">
    <div>
      <h3>Leading models</h3>
      <details><summary>Selection and measurement details</summary>
      <p>
        One recent model per provider with AA Index, pricing, and speed available.
        Rows are ordered by AA Index, then by the number of available measurements.
        Index values are points, not percentages.
        This describes the data, it does not recommend a model.
      </p>
      <p>{[...new Set(models.map((model) => aaEvidenceNote(model.source_metadata)))].join(' ')}</p>
      </details>
    </div>
    {latestObserved ? (
      <p class="latest-models-observed">
        <span class="eco-label">Updated</span>
        <time datetime={latestObserved.toISOString()}>{formatTrackedDate(latestObserved.toISOString())}</time>
      </p>
    ) : null}
  </header>

  {
    models.length ? (
      <ul class="latest-model-grid eco-joined">
        {models.map((model) => (
          <li>
            <a href={compareRecordHref(model.id)}>
              <span class="latest-model-provider">{providerFor(model)}</span>
              <strong title={model.name ?? model.id}>{model.name}</strong>
              <dl>
                <div class="latest-model-lead">
                  <dt>AA index</dt>
                  <dd>{formatIndex(model.aa_intelligence_index)}</dd>
                </div>
                <div>
                  <dt>Coding</dt>
                  <dd>{formatIndex(model.aa_coding_index)}</dd>
                </div>
                <div>
                  <dt>Speed</dt>
                  <dd>{formatTPS(model.median_output_tokens_per_second)}<small> t/s</small></dd>
                </div>
                <div>
                  <dt>Blended</dt>
                  <dd>{formatPrice(model.price_1m_blended_3_to_1, 2)}<small> /1M</small></dd>
                </div>
              </dl>
              <span class="latest-model-action">Compare model</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="latest-model-empty">
        Recent results are unavailable. <a href="/compare">Browse all models</a>.
      </p>
    )
  }
</section>

<style>
  .latest-models {
    display: grid;
    gap: var(--space-6);
  }









  .latest-models-header {
    display: grid;
    gap: var(--space-3);
    align-items: end;
    padding-top: var(--space-5);
    border-top: 1px solid var(--line-1);
  }

  .latest-models-header h2 {
    font-size: var(--text-xl);
  }

  .latest-models-header details > p {
    max-width: 64ch;
    margin-top: var(--space-2);
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .latest-models-header summary {font-size:var(--text-sm);color:var(--ink-1);cursor:pointer;margin-top:var(--space-2);}

  .latest-models-observed {
    display: grid;
    gap: 0.2rem;
    justify-items: start;
  }

  .latest-models-observed time {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink-0);
  }

  .latest-model-grid {
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .latest-model-grid li,
  .latest-model-grid a {
    min-width: 0;
  }

  .latest-model-grid a {
    display: grid;
    height: 100%;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-4);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-standard);
  }

  .latest-model-grid a:hover,
  .latest-model-grid a:focus-visible {
    background: var(--surface-1);
  }

  .latest-model-grid a:focus-visible {
    outline-offset: -2px;
  }

  .latest-model-provider {
    color: var(--ink-2);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .latest-model-grid strong {
    color: var(--ink-0);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-snug);
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .latest-model-grid dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin: var(--space-2) 0 0;
  }

  .latest-model-grid dl div {
    min-width: 0;
  }

  .latest-model-lead {
    grid-column: 1 / -1;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--line-0);
  }

  .latest-model-grid dt {
    color: var(--ink-2);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .latest-model-grid dd {
    margin: 0.1rem 0 0;
    color: var(--ink-0);
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .latest-model-lead dd {
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .latest-model-grid dd small {
    color: var(--ink-2);
    font-size: var(--text-xs);
    font-weight: 400;
  }

  .latest-model-date {
    margin-top: var(--space-2);
    color: var(--ink-3);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }

  .latest-model-date time {
    font-family: inherit;
    color: var(--ink-2);
  }

  .latest-model-action {
    color: var(--signal);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .latest-model-grid a:hover .latest-model-action {
    text-decoration: underline;
  }

  .latest-model-empty {
    border: 1px solid var(--line-1);
    padding: var(--space-4);
    color: var(--ink-1);
    font-size: var(--text-sm);
  }

  @media (min-width: 720px) {
  

  @media (min-width: 1080px) {
    .latest-model-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

 .latest-models{gap:.75rem}
 .latest-models-header{padding-top:0;border-top:0}
 .latest-models-header h3{font-size:var(--text-lg);margin:0}
 .latest-model-grid{display:block}
 .latest-model-grid a{grid-template-columns:minmax(0,1fr) minmax(0,1.45fr) auto;align-items:center;padding:.85rem 1rem;gap:.3rem 1rem}
 .latest-model-provider{grid-column:1;grid-row:1}
 .latest-model-grid strong{grid-column:1;grid-row:2;font-size:var(--text-sm)}
 .latest-model-grid dl{grid-column:2;grid-row:1 / 3;grid-template-columns:repeat(4,minmax(0,1fr));margin:0;gap:.75rem}
 .latest-model-lead{grid-column:auto;border:0;padding:0}
 .latest-model-lead dd{font-size:var(--text-base);line-height:var(--leading-normal)}
 .latest-model-action{grid-column:3;grid-row:1 / 3;font-size:var(--text-xs)}
 @media(max-width:720px){.latest-model-grid a{grid-template-columns:minmax(0,1fr) auto;padding:.85rem}.latest-model-grid dl{grid-column:1 / -1;grid-row:3;margin-top:.4rem;gap:.5rem}.latest-model-action{grid-column:2}.latest-model-grid dd{font-size:.875rem}}
</style>
