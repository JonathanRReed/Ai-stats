---
import type { AaModel } from "../lib/supabase";
import { formatPrice, formatScore, formatTPS } from "../lib/format-utils";

type Props = {
  models: AaModel[];
};

const { models } = Astro.props;
const latestObserved = models
  .map((model) => new Date(model.last_seen ?? ""))
  .filter((date) => !Number.isNaN(date.getTime()))
  .sort((a, b) => b.getTime() - a.getTime())[0];

const formatTrackedDate = (value: string | null | undefined): string => {
  const date = new Date(value ?? "");
  if (Number.isNaN(date.getTime())) return "Unknown";
  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(date);
};
---

<section class="latest-models" aria-label="Current benchmark snapshot">
  <header class="latest-models-header">
    <div>
      <h1>AI model benchmark snapshot</h1>
    </div>
    <p>
      One recent model per provider with AA Index, pricing, and speed available.
      Rows are ordered by AA Index, then by the number of available measurements.
      This describes the data, it does not recommend a model.
      {latestObserved ? ` Latest observation in this cohort: ${formatTrackedDate(latestObserved.toISOString())}.` : ""}
    </p>
  </header>

  {
    models.length ? (
      <ul class="latest-model-grid">
        {models.map((model) => (
          <li>
            <a href={`/compare?model=${encodeURIComponent(model.name ?? model.id)}`}>
              <span class="latest-model-date">
                First tracked <time datetime={model.first_seen}>{formatTrackedDate(model.first_seen)}</time>
                <span aria-hidden="true"> · </span>
                last observed <time datetime={model.last_seen}>{formatTrackedDate(model.last_seen)}</time>
              </span>
              <strong title={model.name ?? model.id}>{model.name}</strong>
              <span class="latest-model-provider">
                {model.company_name ?? model.creator_name ?? "Unknown provider"}
              </span>
              <dl>
                <div>
                  <dt>AA index</dt>
                  <dd>{formatScore(model.aa_intelligence_index)}</dd>
                </div>
                <div>
                  <dt>Coding</dt>
                  <dd>{formatScore(model.aa_coding_index)}</dd>
                </div>
                <div>
                  <dt>Speed</dt>
                  <dd>{formatTPS(model.median_output_tokens_per_second)} t/s</dd>
                </div>
                <div>
                  <dt>Blended</dt>
                  <dd>{formatPrice(model.price_1m_blended_3_to_1, 2)}</dd>
                </div>
              </dl>
              <span class="latest-model-action">Compare model</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="latest-model-empty">
        Current fully measured observations are unavailable in this build. <a href="/compare/">Open the benchmark comparison</a> to inspect the available source-native rows and their data status.
      </p>
    )
  }
</section>

<style>
  .latest-models {
    display: grid;
    gap: 1rem;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    padding: 1.25rem 0;
  }

  .latest-models-header {
    display: grid;
    gap: 0.75rem;
    align-items: end;
  }

  .latest-models-header h1 {
    margin-top: 0.25rem;
    max-width: 17ch;
    color: var(--text);
    font-size: clamp(1.75rem, 4vw, 3.4rem);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .latest-models-header > p {
    max-width: 68ch;
    color: var(--subtle);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .latest-model-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .latest-model-grid li,
  .latest-model-grid a {
    min-width: 0;
  }

  .latest-model-grid a {
    display: grid;
    height: 100%;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
    border: 1px solid var(--border-color);
    background: var(--surface);
    padding: 0.9rem;
    color: inherit;
    text-decoration: none;
    transition: border-color 150ms ease, background-color 150ms ease;
  }

  .latest-model-grid a:hover,
  .latest-model-grid a:focus-visible {
    border-color: var(--love);
    background: var(--overlay);
  }

  .latest-model-grid a:focus-visible {
    outline: 2px solid var(--love);
    outline-offset: 2px;
  }

  .latest-model-date,
  .latest-model-provider,
  .latest-model-action,
  .latest-model-grid dt,
  .latest-model-grid dd {
    font-family: var(--font-mono);
  }

  .latest-model-date {
    color: var(--muted);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .latest-model-provider,
  .latest-model-date {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .latest-model-grid strong {
    color: var(--text);
    font-size: 0.98rem;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .latest-model-provider {
    color: var(--subtle);
    font-size: 0.7rem;
  }

  .latest-model-grid dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0.5rem 0 0;
  }

  .latest-model-grid dl div {
    min-width: 0;
    border-top: 1px solid var(--highlight-low);
    padding-top: 0.45rem;
  }

  .latest-model-grid dt {
    color: var(--muted);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .latest-model-grid dd {
    margin: 0.15rem 0 0;
    color: var(--text);
    font-size: 0.72rem;
    font-weight: 750;
  }

  .latest-model-action {
    margin-top: 0.25rem;
    color: var(--foam);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .latest-model-empty {
    border: 1px solid var(--border-color);
    padding: 1rem;
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  @media (min-width: 720px) {
    .latest-models-header {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.9fr);
    }

    .latest-model-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .latest-model-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .latest-model-grid a {
      transition: none;
    }
  }
</style>
