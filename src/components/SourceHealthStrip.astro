---
import type {
  DataFreshness,
  SourceFreshness,
  SourceFreshnessStatus,
} from "../lib/data-freshness";

interface Props {
  freshness: DataFreshness;
}

const { freshness } = Astro.props;
const requiredSources = [
  { sourceKey: "artificial-analysis", displayName: "Artificial Analysis" },
  { sourceKey: "epoch-ai", displayName: "Epoch AI" },
  { sourceKey: "simplebench", displayName: "SimpleBench" },
  { sourceKey: "polibench", displayName: "PoliBench" },
];

const sourceByKey = new Map(
  freshness.sources.map((source) => [source.sourceKey, source]),
);
const sources: SourceFreshness[] = requiredSources.map((required) =>
  sourceByKey.get(required.sourceKey) ?? {
    ...required,
    status: "unavailable",
    lastObservedAt: null,
    lastSuccessfulRunAt: null,
    coverageLabel: null,
    ageDays: null,
    message: "No source snapshot is available yet.",
  },
);

const statusLabels: Record<SourceFreshnessStatus, string> = {
  healthy: "Checked recently",
  stale: "Refresh overdue",
  partial: "Partial",
  failed: "Failed",
  unavailable: "Unavailable",
};
const statusState: Record<SourceFreshnessStatus, string> = {
  healthy: "ok",
  stale: "warn",
  partial: "warn",
  failed: "bad",
  unavailable: "none",
};
const observedFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const formatObserved = (value: Date | null): string =>
  value ? observedFormatter.format(value) : "Not observed";
---

<section class="source-health eco-panel" aria-label="Source health">
  <header class="eco-panel-head">
    <div>
      <h2>Source health</h2>
      <p>Refresh status does not mean the underlying results are new. Check each observation date. All dates UTC.</p>
    </div>
    <p class="fallback-mode">
      <span class="eco-label">Data mode</span>
      <b>Published source status</b>
    </p>
  </header>
  <div class="source-health-grid">
    {sources.map((source) => (
      <article data-source-status={source.status}>
        <h3>{source.displayName}</h3>
        <p class="status-label eco-status" data-state={statusState[source.status]}>
          <span aria-hidden="true" />
          {statusLabels[source.status]}
          {source.ageDays !== null ? `, ${source.ageDays}d since last successful check` : ""}
        </p>
        <dl>
          <div>
            <dt>Last observed</dt>
            <dd>
              {source.lastObservedAt ? (
                <time datetime={source.lastObservedAt.toISOString()}>
                  {formatObserved(source.lastObservedAt)}
                </time>
              ) : (
                "Not observed"
              )}
            </dd>
          </div>
          <div>
            <dt>Coverage</dt>
            <dd>{source.coverageLabel ?? "Coverage unavailable"}</dd>
          </div>
          <div>
            <dt>Last successful refresh</dt>
            <dd>
              {source.lastSuccessfulRunAt ? (
                <time datetime={source.lastSuccessfulRunAt.toISOString()}>
                  {formatObserved(source.lastSuccessfulRunAt)}
                </time>
              ) : (
                "Not available"
              )}
            </dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>{statusLabels[source.status]}</dd>
          </div>
        </dl>
        <p class="source-message">{source.message}</p>
      </article>
    ))}
  </div>
  {freshness.fallback.reason && <p class="fallback-reason">{freshness.fallback.reason}</p>}
</section>

<style>
  .fallback-mode {
    display: grid;
    gap: 0.1rem;
    text-align: right;
  }
  .fallback-mode b {
    color: var(--ink-0);
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .source-health-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--line-0);
  }
  .source-health-grid article {
    min-width: 0;
    padding: var(--space-4);
    background: var(--surface-1);
  }
  .source-health-grid h3 {
    font-size: var(--text-base);
    font-weight: 600;
  }
  .status-label {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
  }
  .status-label span {
    display: none;
  }
  .source-health-grid dl {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line-0);
  }
  .source-health-grid dl div {
    display: grid;
    grid-template-columns: minmax(7rem, 0.9fr) minmax(0, 1fr);
    gap: var(--space-2);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }
  .source-health-grid dt {
    color: var(--ink-2);
  }
  .source-health-grid dd {
    margin: 0;
    color: var(--ink-1);
    overflow-wrap: anywhere;
  }
  .source-health-grid dd time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .source-message {
    margin-top: var(--space-3);
    color: var(--ink-2);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }
  .fallback-reason {
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--line-0);
    color: var(--ink-2);
    font-size: var(--text-xs);
  }
  @media (max-width: 960px) {
    .source-health-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 580px) {
    .fallback-mode { text-align: left; }
    .source-health-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .source-health * { scroll-behavior: auto; }
  }
</style>
