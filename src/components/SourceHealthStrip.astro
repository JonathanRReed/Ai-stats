---
import {PUBLIC_CATALOG_NAMES} from "../lib/catalog-cache";
import type {
  DataFreshness,
  SourceFreshness,
  SourceFreshnessStatus,
} from "../lib/data-freshness";

interface Props {
  freshness: DataFreshness;
}

const { freshness } = Astro.props;
const requiredSources = [
  { sourceKey: "artificial-analysis", displayName: "Artificial Analysis" },
  { sourceKey: "epoch-ai", displayName: "Epoch AI" },
  { sourceKey: "simplebench", displayName: "SimpleBench" },
  { sourceKey: "polibench", displayName: "PoliBench" },
  ...Object.entries(PUBLIC_CATALOG_NAMES).map(([sourceKey,displayName])=>({sourceKey,displayName})),
];

const sourceByKey = new Map(
  freshness.sources.map((source) => [source.sourceKey, source]),
);
const sources: SourceFreshness[] = requiredSources.map((required) =>
  sourceByKey.get(required.sourceKey) ?? {
    ...required,
    status: "unavailable",
    lastObservedAt: null,
    lastSuccessfulRunAt: null,
    coverageLabel: null,
    ageDays: null,
    message: "No source snapshot is available yet.",
  },
);

const statusLabels: Record<SourceFreshnessStatus, string> = {
  healthy: "Checked recently",
  stale: "Refresh overdue",
  partial: "Partial",
  failed: "Failed",
  unavailable: "Unavailable",
};
const statusState: Record<SourceFreshnessStatus, string> = {
  healthy: "ok",
  stale: "warn",
  partial: "warn",
  failed: "bad",
  unavailable: "none",
};
const observedFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
  hour: "2-digit",minute: "2-digit",hour12:false,
});
const formatObserved = (value: Date | null): string =>
  value ? observedFormatter.format(value) : "Not observed";
---

<section class="source-health eco-panel" aria-label="Source health">
  <header class="eco-panel-head">
    <div>
      <h2>Source health</h2>
      <p>Refresh status does not mean the underlying results are new. Check each observation date. All dates UTC.</p>
    </div>
    <p class="fallback-mode">
      <span class="eco-label">Data mode</span>
      <b>Source receipts</b>
    </p>
  </header>
  <div class="source-health-grid">
    {sources.map((source) => (
      <article data-source-status={source.status} data-catalog-receipt={Object.hasOwn(PUBLIC_CATALOG_NAMES,source.sourceKey)?source.sourceKey:undefined} data-content-hash={source.contentHash??""}>
        <h3>{source.displayName}</h3>
        <p class="status-label eco-status" data-state={statusState[source.status]}>
          <span aria-hidden="true" />
          {statusLabels[source.status]}
          {source.ageDays !== null ? `, ${source.ageDays}d since last successful check` : ""}
        </p>
        <dl>
          <div>
            <dt>Last observed</dt>
            <dd>
              {source.lastObservedAt ? (
                <time datetime={source.lastObservedAt.toISOString()}>
                  {formatObserved(source.lastObservedAt)}
                </time>
              ) : (
                "Not observed"
              )}
            </dd>
          </div>
          <div>
            <dt>Coverage</dt>
            <dd>{source.coverageLabel ?? "Coverage unavailable"}</dd>
          </div>
          <div>
            <dt>Retrieved</dt>
            <dd class="source-retrieved">
              {(source.fetchedAt??source.lastSuccessfulRunAt) ? (
                <time datetime={(source.fetchedAt??source.lastSuccessfulRunAt)!.toISOString()}>
                  {formatObserved(source.fetchedAt??source.lastSuccessfulRunAt)}
                </time>
              ) : (
                "Not available"
              )}
            </dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd class="source-status-detail">{statusLabels[source.status]}</dd>
          </div>
          {source.publishedAt&&<div><dt>Published</dt><dd><time datetime={source.publishedAt.toISOString()}>{formatObserved(source.publishedAt)}</time></dd></div>}
        </dl>
        <p class="source-message">{source.message}</p>
      </article>
    ))}
  </div>
  {freshness.fallback.reason && <p class="fallback-reason">{freshness.fallback.reason}</p>}
</section>

<style>
  .fallback-mode {
    display: grid;
    gap: 0.1rem;
    text-align: right;
  }
  .fallback-mode b {
    color: var(--ink-0);
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .source-health-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--line-0);
  }
  .source-health-grid article {
    min-width: 0;
    padding: var(--space-4);
    background: var(--surface-1);
  }
  .source-health-grid h3 {
    font-size: var(--text-base);
    font-weight: 600;
  }
  .status-label {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
  }
  .status-label span {
    display: none;
  }
  .source-health-grid dl {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line-0);
  }
  .source-health-grid dl div {
    display: grid;
    grid-template-columns: minmax(7rem, 0.9fr) minmax(0, 1fr);
    gap: var(--space-2);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }
  .source-health-grid dt {
    color: var(--ink-2);
  }
  .source-health-grid dd {
    margin: 0;
    color: var(--ink-1);
    overflow-wrap: anywhere;
  }
  .source-health-grid dd time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .source-message {
    margin-top: var(--space-3);
    color: var(--ink-2);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }
  .fallback-reason {
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--line-0);
    color: var(--ink-2);
    font-size: var(--text-xs);
  }
  @media (max-width: 960px) {
    .source-health-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 580px) {
    .fallback-mode { text-align: left; }
    .source-health-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .source-health * { scroll-behavior: auto; }
  }
</style>

<script>
  import {catalogReceiptUpdate,catalogReceiptPresentation} from "../lib/catalog-cache";
  async function refreshCatalogReceipts(){
    const articles=[...document.querySelectorAll<HTMLElement>('[data-catalog-receipt]:not([data-receipt-bound])')];
    if(!articles.length)return;
    articles.forEach(article=>{article.dataset.receiptBound="true";});
    const rawUrl=import.meta.env.PUBLIC_SUPABASE_URL;
    const key=import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    if(!rawUrl||!key)return;
    try{
      const url=new URL(rawUrl);
      if(url.protocol!=="https:"||url.hostname!=="bgbqdzmgxkwstjihgeef.supabase.co"||url.username||url.password)return;
      url.pathname="/rest/v1/source_snapshot_cache";
      url.search=new URLSearchParams({source_key:"in.(openrouter,huggingface,litellm)",select:"source_key,snapshot_id,content_hash,observed_at,fetched_at,published_at,refresh_status,refresh_message"}).toString();
      const response=await fetch(url,{headers:{apikey:key,Authorization:"Bearer "+key},cache:"no-store",signal:AbortSignal.timeout(10000)});
      if(!response.ok)return;
      const rows:unknown=await response.json();if(!Array.isArray(rows))return;
      for(const article of articles){
        const row=rows.find(value=>value&&typeof value==="object"&&value.source_key===article.dataset.catalogReceipt);
        const receipt=catalogReceiptUpdate(article.dataset.contentHash??"",row);if(!receipt)continue;
        const message=article.querySelector(".source-message");
        const presentation=catalogReceiptPresentation(receipt);
        article.dataset.sourceStatus=presentation.status;
        const badge=article.querySelector<HTMLElement>(".status-label");
        if(badge){badge.dataset.state=presentation.state;badge.textContent=presentation.label;}
        const detail=article.querySelector(".source-status-detail");if(detail)detail.textContent=presentation.label;
        if(message)message.textContent=presentation.message;
        if(!receipt.sameSnapshot)continue;
        const time=article.querySelector<HTMLTimeElement>(".source-retrieved time");
        if(time){time.dateTime=receipt.fetchedAt;time.textContent=new Intl.DateTimeFormat("en-US",{month:"short",day:"numeric",year:"numeric",hour:"2-digit",minute:"2-digit",hour12:false,timeZone:"UTC"}).format(new Date(receipt.fetchedAt));}
      }
    }catch{ /* Keep the dated server-rendered receipt when the cache cannot be reached. */ }
  }
  refreshCatalogReceipts();
  document.addEventListener("astro:page-load",refreshCatalogReceipts);
</script>
