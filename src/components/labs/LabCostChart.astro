---
/**
 * AA Intelligence Index against cost for every family of one lab, one line per family joining
 * its reasoning levels. Static SVG on a log cost axis, drawn at a wide and a narrow width.
 */
import { plotGeometry, formatChartNumber } from "../../lib/compare-geometry";
import type { LabChart } from "../../lib/lab-pages";

interface Props {
  chart: LabChart;
  width: number;
  height: number;
  class?: string;
  titleId: string;
  descId: string;
  axisLabel: string;
}

const { chart, width, height, class: className, titleId, descId, axisLabel } = Astro.props;
const narrow = width < 500;
const points = chart.lines.flatMap((line) => line.points);
const geometry = plotGeometry(points, "scatter", "log", width, height, 16, narrow ? 16 : 140, narrow ? 44 : 56);
const position = new Map(geometry.points.map((point) => [point.id, point]));
const reasoningLabel = (value: string) => (value === "unknown" ? "" : value === "none" ? "no reasoning" : value);
const money = (value: number) => `$${formatChartNumber(value)}`;
// Direct labels at each line's right end; a label that would collide is left to the legend.
const placed: Array<{ x1: number; x2: number; y1: number; y2: number }> = [];
const labels = narrow ? [] : chart.lines.flatMap((line) => {
  const end = [...line.points].sort((a, b) => b.x - a.x)[0];
  const at = position.get(end.id);
  if (!at) return [];
  const text = line.family.length > 22 ? `${line.family.slice(0, 20)}…` : line.family;
  const box = { x1: at.cx + 8, x2: at.cx + 8 + text.length * 6.6, y1: at.cy - 9, y2: at.cy + 5 };
  if (box.x2 > width - 2 || placed.some((other) => box.x1 < other.x2 && box.x2 > other.x1 && box.y1 < other.y2 && box.y2 > other.y1)) return [];
  placed.push(box);
  return [{ family: line.family, text, x: box.x1, y: at.cy + 4 }];
});
const total = points.length;
// familyColor() keys on the brand prefix, so every family of one lab would share a colour; use line order instead.
const colorOf = (family: string) => `var(--compare-family-${Math.max(0, chart.lines.findIndex((line) => line.family === family)) % 9})`;
---

<svg class:list={["lab-chart", className]} viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${titleId} ${descId}`}>
  <title id={titleId}>AA Intelligence Index against {axisLabel}</title>
  <desc id={descId}>{total} models in {chart.lines.length} families. Each line joins one family's reasoning levels. The same values are in the table below.</desc>
  {geometry.yTicks.map((tick) => (
    <g>
      <line class="plot-grid" x1={geometry.left} x2={geometry.right} y1={tick.position} y2={tick.position} />
      <text class="plot-tick" x={geometry.left - 8} y={tick.position + 4} text-anchor="end">{tick.label}</text>
    </g>
  ))}
  {geometry.xTicks.map((tick) => (
    <g>
      <line class="plot-grid" x1={tick.position} x2={tick.position} y1={geometry.top} y2={geometry.bottom} />
      <text class="plot-tick" x={tick.position} y={geometry.bottom + 18} text-anchor="middle">{money(tick.value)}</text>
    </g>
  ))}
  <line class="plot-axis" x1={geometry.left} x2={geometry.right} y1={geometry.bottom} y2={geometry.bottom} />
  <line class="plot-axis" x1={geometry.left} x2={geometry.left} y1={geometry.top} y2={geometry.bottom} />
  {chart.lines.map((line) => {
    const at = line.points.map((point) => position.get(point.id)).filter((point) => point !== undefined);
    return (
      <g style={`color:${colorOf(line.family)}`}>
        {at.length > 1 ? <polyline class="variant-link" stroke="currentColor" points={at.map((point) => `${point.cx.toFixed(1)},${point.cy.toFixed(1)}`).join(" ")} /> : null}
        {line.points.map((point) => {
          const p = position.get(point.id);
          return p ? (
            <circle class="point-mark" cx={p.cx} cy={p.cy} r="4.5" fill="currentColor">
              <title>{point.name}{reasoningLabel(point.reasoning) ? ` (${reasoningLabel(point.reasoning)})` : ""}: Index {point.y.toFixed(1)}, {money(point.x)}</title>
            </circle>
          ) : null;
        })}
      </g>
    );
  })}
  {labels.map((label) => <text class="plot-label lab-chart-label" x={label.x} y={label.y} style={`fill:${colorOf(label.family)}`}>{label.text}</text>)}
  <text class="plot-tick lab-axis-title" x={(geometry.left + geometry.right) / 2} y={height - 8} text-anchor="middle">{axisLabel} (log scale)</text>
  <text class="plot-tick lab-axis-title" transform={`translate(12 ${(geometry.top + geometry.bottom) / 2}) rotate(-90)`} text-anchor="middle">AA Intelligence Index</text>
</svg>
