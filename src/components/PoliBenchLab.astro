---
import type { PublicPoliBenchSnapshot } from '../lib/polibench-snapshot';

interface Props {
  snapshot: PublicPoliBenchSnapshot | null;
}

const { snapshot } = Astro.props;
const models = snapshot ? [...snapshot.models].sort((a, b) => a.label.localeCompare(b.label)) : [];
const selected = models[0] ?? null;
const expectedByRunId = new Map((snapshot?.runs ?? []).map((run) => [run.runId, run.expectedResponses]));
const selectedExpected = selected ? expectedByRunId.get(selected.runId) ?? null : null;
const generatedAt = snapshot?.freshness.generatedAt
  ? new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(snapshot.freshness.generatedAt))
  : 'Unavailable';
const percent = (value: number): string => `${value.toFixed(1)}%`;
const signed = (value: number): string => `${value > 0 ? '+' : ''}${value.toFixed(1)}`;
const payloadJson = JSON.stringify(models.map((model) => ({
  ...model,
  expectedResponses: expectedByRunId.get(model.runId) ?? null,
}))).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');
---

<section class="polibench-lab" aria-labelledby="polibench-title">
  <header class="polibench-header">
    <div>
      <h2 id="polibench-title">PoliBench political-response profiles</h2>
    </div>
    <a href="https://polibench.jonathanrreed.com/methodology/" rel="noopener">Methodology and artifacts on PoliBench</a>
  </header>

  <div class="polibench-mode" aria-label="PoliBench evidence state">
    <button type="button" aria-pressed="true">Latest checked snapshot, {generatedAt}</button>
    <button type="button" disabled aria-describedby="polibench-frozen-status">Frozen paper release</button>
    <span id="polibench-frozen-status">No frozen model roster has passed the paper-release gate.</span>
  </div>

  {snapshot && selected ? (
    <div class="polibench-grid">
      <div class="polibench-selector">
        <label for="polibench-model">Choose a model</label>
        <select id="polibench-model">
          {models.map((model) => <option value={model.modelSlug}>{model.label} · {model.provider}</option>)}
        </select>
        <p>{snapshot.evidence.boundary}</p>
        <dl>
          <div><dt>Snapshot</dt><dd>{generatedAt}</dd></div>
          <div><dt>Models</dt><dd>{snapshot.counts.models}</dd></div>
          <div><dt>Runs</dt><dd>{snapshot.counts.runs}</dd></div>
          <div><dt>Validation</dt><dd>Machine-only, not externally validated</dd></div>
        </dl>
      </div>

      <article class="polibench-receipt" data-polibench-receipt>
        <header>
          <div><h3 data-pb-name>{selected.label}</h3><p data-pb-provider>{selected.provider}</p></div>
          <span data-pb-release>{selected.releases.benchmarkRelease}</span>
        </header>
        <dl class="polibench-measures">
          <div><dt>Evidence level</dt><dd data-pb-evidence>{selected.evidenceLevel} · {selected.evidenceLabel}</dd></div>
          <div><dt>Completion</dt><dd data-pb-completion>{percent(selected.completionRate)} · {selected.completedResponses}/{selectedExpected ?? "?"} responses</dd></div>
          <div><dt>Parse validity</dt><dd data-pb-parse>{percent(selected.parseValidity)}</dd></div>
          <div><dt>Robustness</dt><dd data-pb-robustness>{percent(selected.robustness)}</dd></div>
        </dl>
        <div class="axis-scale" aria-hidden="true">
          <span>−100</span><span>0</span><span>+100</span>
        </div>
        <div class="polibench-axes" data-pb-axes aria-label={`Nine directional axis scores for ${selected.label}. Values range from negative 100 to positive 100.`}>
          {selected.axisScores.map((axis) => (
            <div class="axis-row">
              <span>{axis.axis}</span>
              <div><i style={`--axis-position:${Math.max(0, Math.min(100, (axis.score + 100) / 2))}%`}></i></div>
              <b>{signed(axis.score)}</b>
              <small>{axis.answeredItems} items</small>
            </div>
          ))}
        </div>
        <p class="polibench-uncertainty" data-pb-uncertainty>{selected.uncertaintySummary}</p>
      </article>
    </div>
  ) : (
    <p class="polibench-empty">The checked PoliBench snapshot is unavailable. No live profile is shown.</p>
  )}
</section>

<script id="polibench-data" type="application/json" is:inline set:html={payloadJson}></script>

<script>
  type Axis = { axis: string; score: number; answeredItems: number };
  type Model = {
    modelSlug: string; label: string; provider: string; evidenceLevel: number; evidenceLabel: string;
    completionRate: number; completedResponses: number; expectedResponses: number | null; parseValidity: number; robustness: number; uncertaintySummary: string;
    releases: { benchmarkRelease: string }; axisScores: Axis[];
  };
  const root = document.querySelector<HTMLElement>('.polibench-lab');
  const select = root?.querySelector<HTMLSelectElement>('#polibench-model');
  const payload = document.querySelector<HTMLScriptElement>('#polibench-data');
  let models: Model[] = [];
  try { models = JSON.parse(payload?.textContent ?? '[]') as Model[]; } catch { models = []; }
  const setText = (selector: string, value: string) => {
    const node = root?.querySelector<HTMLElement>(selector);
    if (node) node.textContent = value;
  };
  const render = (model: Model) => {
    setText('[data-pb-name]', model.label);
    setText('[data-pb-provider]', model.provider);
    setText('[data-pb-release]', model.releases.benchmarkRelease);
    setText('[data-pb-evidence]', `${model.evidenceLevel} · ${model.evidenceLabel}`);
    setText('[data-pb-completion]', `${model.completionRate.toFixed(1)}% · ${model.completedResponses}/${model.expectedResponses ?? '?'} responses`);
    setText('[data-pb-parse]', `${model.parseValidity.toFixed(1)}%`);
    setText('[data-pb-robustness]', `${model.robustness.toFixed(1)}%`);
    setText('[data-pb-uncertainty]', model.uncertaintySummary);
    const axes = root?.querySelector<HTMLElement>('[data-pb-axes]');
    if (!axes) return;
    axes.setAttribute('aria-label', `Nine directional axis scores for ${model.label}. Values range from negative 100 to positive 100.`);
    const rows = axes.querySelectorAll<HTMLElement>('.axis-row');
    model.axisScores.forEach((axis, index) => {
      const row = rows[index];
      if (!row) return;
      const label = row.querySelector<HTMLElement>('span');
      const point = row.querySelector<HTMLElement>('i');
      const score = row.querySelector<HTMLElement>('b');
      const count = row.querySelector<HTMLElement>('small');
      if (label) label.textContent = axis.axis;
      point?.style.setProperty('--axis-position', `${Math.max(0, Math.min(100, (axis.score + 100) / 2))}%`);
      if (score) score.textContent = `${axis.score > 0 ? '+' : ''}${axis.score.toFixed(1)}`;
      if (count) count.textContent = `${axis.answeredItems} items`;
    });
  };
  select?.addEventListener('change', () => {
    const model = models.find((item) => item.modelSlug === select.value);
    if (model) render(model);
  });
</script>

<style>
  .polibench-lab { background: var(--surface-1); border: 1px solid var(--line-0); border-radius: var(--radius-md); }
  .polibench-header { display: flex; align-items: end; justify-content: space-between; gap: var(--space-4); border-bottom: 1px solid var(--line-0); padding: var(--space-4); }
  .polibench-header h2 { color: var(--ink-0); font-size: var(--text-xl); }
  .polibench-header a { color: var(--signal); font-size: var(--text-sm); font-weight: 500; text-underline-offset: 4px; }
  .polibench-header a:hover { text-decoration: underline; }
  .polibench-mode { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); border-bottom: 1px solid var(--line-0); padding: var(--space-3) var(--space-4); }
  .polibench-mode button { min-height: 2.5rem; border: 1px solid var(--line-1); border-radius: var(--radius-md); background: transparent; padding: 0 var(--space-3); color: var(--ink-1); font-size: var(--text-xs); font-weight: 500; }
  .polibench-mode button[aria-pressed='true'] { border-color: var(--signal); background: var(--signal-soft); color: var(--ink-0); }
  .polibench-mode button:disabled { opacity: 0.5; cursor: not-allowed; }
  .polibench-mode span { color: var(--ink-2); font-size: var(--text-xs); }
  .polibench-grid { display: grid; grid-template-columns: minmax(15rem, 0.72fr) minmax(0, 1.5fr); gap: 1px; background: var(--line-0); }
  .polibench-selector, .polibench-receipt { min-width: 0; padding: var(--space-4); background: var(--surface-1); }
  .polibench-selector label { display: block; color: var(--ink-2); font-size: var(--text-xs); font-weight: 500; }
  .polibench-selector select { width: 100%; min-height: var(--control-h); margin-top: var(--space-1); border: 1px solid var(--line-1); border-radius: var(--radius-md); background: var(--surface-0); padding: 0 var(--space-3); color: var(--ink-0); font-size: var(--text-sm); }
  .polibench-selector > p { margin-top: var(--space-4); color: var(--ink-1); font-size: var(--text-sm); line-height: var(--leading-normal); }
  .polibench-selector dl { display: grid; gap: var(--space-2); margin: var(--space-4) 0 0; }
  .polibench-selector dl div { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: var(--space-2); border-top: 1px solid var(--line-0); padding-top: var(--space-2); font-size: var(--text-xs); }
  .polibench-selector dt { color: var(--ink-2); }
  .polibench-selector dd { margin: 0; color: var(--ink-1); }
  .polibench-receipt > header { display: flex; align-items: start; justify-content: space-between; gap: var(--space-4); }
  .polibench-receipt h3 { color: var(--ink-0); font-size: var(--text-lg); font-weight: 600; }
  .polibench-receipt header p { color: var(--ink-2); font-size: var(--text-xs); }
  .polibench-receipt header > span { color: var(--ink-2); font-family: var(--font-mono); font-size: var(--text-xs); }
  .polibench-measures { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin: var(--space-4) 0; border: 1px solid var(--line-0); background: var(--line-0); }
  .polibench-measures div { min-width: 0; padding: var(--space-3); background: var(--surface-1); }
  .polibench-measures dt { color: var(--ink-2); font-size: var(--text-xs); font-weight: 500; }
  .polibench-measures dd { margin: 0.2rem 0 0; color: var(--ink-0); font-family: var(--font-mono); font-size: var(--text-sm); overflow-wrap: anywhere; }
  .polibench-axes { display: grid; gap: var(--space-2); }
  .axis-scale { display: grid; grid-template-columns: minmax(5.5rem, 0.65fr) minmax(8rem, 2fr) 3.6rem 3.8rem; gap: var(--space-2); margin-bottom: 0.35rem; color: var(--ink-2); font-family: var(--font-mono); font-size: 0.65rem; }
  .axis-scale span:nth-child(1) { grid-column: 2; justify-self: start; }
  .axis-scale span:nth-child(2) { grid-column: 2; justify-self: center; }
  .axis-scale span:nth-child(3) { grid-column: 2; justify-self: end; }
  .axis-row { display: grid; grid-template-columns: minmax(5.5rem, 0.65fr) minmax(8rem, 2fr) 3.6rem 3.8rem; align-items: center; gap: var(--space-2); }
  .axis-row > span { color: var(--ink-1); font-size: var(--text-xs); text-transform: capitalize; }
  .axis-row b { color: var(--ink-0); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 500; text-align: right; }
  .axis-row small { color: var(--ink-2); font-family: var(--font-mono); font-size: 0.65rem; text-align: right; }
  .axis-row > div { position: relative; height: 0.4rem; border-radius: 2px; background: var(--surface-3); }
  .axis-row > div::after { position: absolute; inset: -0.2rem auto -0.2rem 50%; width: 1px; background: var(--ink-3); content: ''; }
  .axis-row i { position: absolute; top: 50%; left: var(--axis-position); width: 0.6rem; height: 0.6rem; border-radius: 50%; border: 1px solid var(--surface-0); background: var(--info); transform: translate(-50%, -50%); }
  .polibench-uncertainty { margin-top: var(--space-4); border-top: 1px solid var(--line-0); padding-top: var(--space-3); color: var(--ink-2); font-size: var(--text-xs); line-height: var(--leading-snug); }
  .polibench-empty { padding: var(--space-4); color: var(--ink-2); }
  @media (max-width: 820px) { .polibench-grid { grid-template-columns: 1fr; } .polibench-measures { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) {
    .polibench-header { align-items: start; flex-direction: column; }
    .axis-scale { grid-template-columns: 5rem minmax(6rem, 1fr) 3rem; }
    .axis-row { grid-template-columns: 5rem minmax(6rem, 1fr) 3rem; }
    .axis-row small { grid-column: 2 / 4; text-align: left; }
  }
</style>
