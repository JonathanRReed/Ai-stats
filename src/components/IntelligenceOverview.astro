---
import type { DataFreshness } from "../lib/data-freshness";
import type { PublicPoliBenchSnapshot } from "../lib/polibench-snapshot";
import type { AaModel, EpochBenchmark, EpochBenchmarkRun, EpochModel } from "../lib/supabase";
import { hasFiniteMetricValue } from "../lib/metric-values";
import { buildExplorerCatalog } from "../lib/compare-catalog";
import OverviewExplorer from "./compare/OverviewExplorer";
import { suggestedModels } from "../lib/suggested-models";

interface Props {
  models: AaModel[];
  epochModels: EpochModel[];
  epochBenchmarks: EpochBenchmark[];
  epochRuns: EpochBenchmarkRun[];
  polibench: PublicPoliBenchSnapshot | null;
  freshness: DataFreshness;
}

const { models, epochModels, epochRuns, polibench, freshness } = Astro.props;
const explorerModels = buildExplorerCatalog(models, []);
const versions=[...new Set(explorerModels.filter(model=>model.source==='aa'&&model.current===true&&model.indexVersion&&/^\d+(?:\.\d+)*$/.test(model.indexVersion)).map(model=>model.indexVersion!))];
const suggestions = Object.fromEntries(versions.flatMap(version=>(['task-cost','cost-intelligence'] as const).map(metric=>{
  const rows=explorerModels.filter(model=>model.source==='aa'&&model.current===true&&model.indexVersion===version&&typeof model.intelligence==='number'&&Number.isFinite(model.intelligence)&&
    typeof (metric==='task-cost'?model.aaTaskCost:model.priceBlended)==='number'&&Number.isFinite(metric==='task-cost'?model.aaTaskCost:model.priceBlended));
  return [`${metric}:${version}`,suggestedModels(rows.map(model=>({id:model.id,modelId:model.id,x:(metric==='task-cost'?model.aaTaskCost:model.priceBlended)!,y:model.intelligence!,provider:model.provider,family:model.family,
    indexVersion:model.indexVersion!,cohortKey:model.indexVersion+':'+(model.performancePrompt??'unknown')})))];
})));
const aaIntelligenceCount = models.filter(model => hasFiniteMetricValue(model.aa_intelligence_index)).length;
const aaCodingCount = models.filter(model => hasFiniteMetricValue(model.aa_coding_index) || hasFiniteMetricValue(model.livecodebench)).length;
const epochModelVersions = new Set(epochRuns.map(run => run.model_version).filter(Boolean));
const simpleBenchRuns = epochRuns.filter(run => String(run.benchmark_slug ?? run.benchmark_name ?? "").toLowerCase().includes("simplebench"));
const coverageRows = [
  { label: "AA Index measurements", detail: `${aaIntelligenceCount} / ${models.length} current AA records`, value: aaIntelligenceCount, max: Math.max(models.length,1) },
  { label: "Coding measurements", detail: `${aaCodingCount} / ${models.length} current AA records`, value: aaCodingCount, max: Math.max(models.length,1) },
  { label: "Epoch records with runs", detail: `${epochModelVersions.size} / ${epochModels.length} model versions`, value: epochModelVersions.size, max: Math.max(epochModels.length,1) },
  { label: "SimpleBench via Epoch snapshot", detail: `${simpleBenchRuns.length.toLocaleString("en-US")} recorded observations`, value: simpleBenchRuns.length, max: 0 },
  { label: "PoliBench checked snapshot", detail: polibench ? `${polibench.counts.models} records / ${polibench.counts.runs} runs` : "No checked snapshot", value: polibench?.counts.models ?? 0, max: 0 },
];
const recentSources = [...freshness.sources].filter(source => source.lastObservedAt !== null)
  .sort((a,b) => Number(b.lastObservedAt)-Number(a.lastObservedAt)).slice(0,5);
const dateFormatter = new Intl.DateTimeFormat("en-US", { month:"short", day:"numeric", year:"numeric", timeZone:"UTC" });
---

<section class="intelligence-overview" aria-label="Model intelligence and cost overview">
  <OverviewExplorer client:load models={explorerModels} suggestions={suggestions} />
  <section class="overview-data-status" aria-label="Source coverage and status">
    <header class="overview-status-heading"><h2>Coverage and source updates</h2><p>Counts describe records and runs in the current build snapshot.</p></header>
    <div class="overview-status-grid">
      <section class="coverage-panel" aria-labelledby="coverage-title">
        <h3 id="coverage-title">Measurement coverage</h3>
        <div class="coverage-list">
          {coverageRows.map(row => <div>
            <div><span>{row.label}</span><b>{row.detail}</b></div>
            {row.max>0?<progress value={row.value} max={row.max} aria-label={`${row.label}: ${row.detail}`}>{row.value} of {row.max}</progress>:null}
          </div>)}
        </div>
      </section>
      <section class="changes-panel" aria-labelledby="changes-title">
        <h3 id="changes-title">Latest source observations</h3>
        {recentSources.length ? <ol>{recentSources.map(source => <li>
          <time datetime={source.lastObservedAt?.toISOString()}>{dateFormatter.format(source.lastObservedAt as Date)}</time>
          <div><strong>{source.displayName}</strong><span>{source.coverageLabel ?? source.message}</span></div>
          <b>{source.status}</b>
        </li>)}</ol> : <p class="changes-empty">No dated source update is available. Checked snapshots remain visible.</p>}
        <a href="/about">Read source methodology</a>
      </section>
    </div>
  </section>
</section>

<style>
  .intelligence-overview{display:grid;gap:1rem}
  .overview-data-status{border-top:1px solid var(--line-0);padding-top:1rem}
  .overview-status-heading{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;margin-bottom:.5rem}
  .overview-status-heading h2{font-size:var(--text-base);font-weight:600;color:var(--ink-0)}
  .overview-status-heading p{font-size:var(--text-xs);color:var(--ink-2)}
  .overview-status-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
  .coverage-panel,.changes-panel{min-width:0;background:var(--surface-1);border:1px solid var(--line-0);padding:1rem;border-radius:var(--radius-md)}
  .coverage-panel h3,.changes-panel h3{font-size:var(--text-sm);font-weight:600;color:var(--ink-0)}
  .coverage-list{display:grid;gap:.75rem;margin-top:.75rem}
  .coverage-list>div>div{display:flex;justify-content:space-between;gap:.75rem;margin-bottom:.3rem}
  .coverage-list span,.coverage-list b{font-size:var(--text-xs);color:var(--ink-1)}
  .coverage-list b{font-family:var(--font-mono);font-weight:500;text-align:right}
  .coverage-list progress{width:100%;height:.375rem;accent-color:var(--info)}
  .changes-panel ol{list-style:none;padding:0;margin:.5rem 0}
  .changes-panel li{display:grid;grid-template-columns:5rem minmax(0,1fr) auto;gap:.6rem;padding:.5rem 0;border-bottom:1px solid var(--line-0)}
  .changes-panel time,.changes-panel li b{font:var(--text-xs) var(--font-mono);color:var(--ink-2);white-space:nowrap}
  .changes-panel li div{display:grid;gap:.15rem}.changes-panel li strong{font-size:var(--text-xs);font-weight:500;color:var(--ink-0)}
  .changes-panel li span,.changes-empty{font-size:var(--text-xs);color:var(--ink-2);line-height:1.45}
  .changes-panel>a{display:inline-block;min-height:44px;padding-top:.7rem;color:var(--signal);font-size:var(--text-sm);text-underline-offset:4px}
  @media(max-width:700px){.overview-status-heading{align-items:flex-start;flex-direction:column;gap:.25rem}.overview-status-grid{grid-template-columns:1fr}.changes-panel li{grid-template-columns:5rem minmax(0,1fr)}.changes-panel li b{grid-column:2}}
</style>
