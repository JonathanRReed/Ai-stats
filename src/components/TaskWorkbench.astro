---
import {
  DEFAULT_TASK_PRESETS,
  rankComparableModels,
  type ModelEvidence,
  type RankedCandidate,
  type TaskPreset,
} from "../lib/model-intelligence";
import type { ReasoningHighlights } from "../lib/reasoning-highlights";

type WorkbenchModel = ModelEvidence & {
  provider: string;
  inputPrice: number | null;
  outputPrice: number | null;
};

interface Props {
  models: WorkbenchModel[];
  reasoningHighlights: ReasoningHighlights;
}

const { models, reasoningHighlights } = Astro.props;
const defaultBudget = 5;
const defaultPreset = DEFAULT_TASK_PRESETS[0];
const weightedKeys = Object.keys(defaultPreset.weights).filter(
  (key) => defaultPreset.weights[key] > 0,
);
const initialCandidates = rankComparableModels(models, {
  ...defaultPreset,
  budget: defaultBudget,
}).slice(0, 3);

const metricLabels: Record<string, string> = {
  aa_coding_index: "AA Coding Index",
  livecodebench: "LiveCodeBench",
  aa_intelligence_index: "AA Intelligence Index",
  gpqa: "GPQA",
  hle: "HLE",
  median_output_tokens_per_second: "Speed",
  price_1m_blended_3_to_1: "Blended price",
};

const percent = (weight: number): string => `${Math.round(weight * 100)}%`;
const formatPrice = (value: number | null | undefined): string =>
  typeof value === "number" && Number.isFinite(value)
    ? `$${value.toFixed(value < 1 ? 2 : 2)}`
    : "Missing";
const formatMetric = (value: number | null | undefined): string =>
  typeof value === "number" && Number.isFinite(value)
    ? value.toFixed(1)
    : "Missing";

const primaryBenchmark = (
  candidate: RankedCandidate,
  preset: TaskPreset,
): { label: string; value: string; unit: string } => {
  const metricKey = Object.keys(preset.weights).find(
    (key) =>
      !key.includes("price") &&
      key !== "median_output_tokens_per_second" &&
      candidate.presentMetricKeys.includes(key),
  );
  if (!metricKey) {
    return { label: "Named benchmark", value: "Missing", unit: "No matching measurement" };
  }
  return {
    label: metricLabels[metricKey] ?? metricKey,
    value: formatMetric(candidate.model.metrics[metricKey]),
    unit: metricKey.startsWith("aa_") ? "index points" : "source-native score",
  };
};

const serializeModels = models.map((model) => ({
  ...model,
  metrics: { ...model.metrics },
}));
const workbenchPayloadJson = JSON.stringify({
  serializeModels,
  taskPresets: DEFAULT_TASK_PRESETS,
  defaultBudget,
})
  .replace(/</g, "\\u003c")
  .replace(/>/g, "\\u003e")
  .replace(/&/g, "\\u0026")
  .replace(/\u2028/g, "\\u2028")
  .replace(/\u2029/g, "\\u2029");
---

<section
  class="task-workbench"
  aria-label="Compare models by task"
  data-shortlist-state={initialCandidates.length ? "ready" : "empty"}
>
  <form class="task-query" data-task-form>
    <span class="task-query-label">Compare by</span>
    <label>
      <span>Task</span>
      <select id="task-preset" name="task">
        {DEFAULT_TASK_PRESETS.map((preset) => (
          <option value={preset.id}>{preset.label}</option>
        ))}
      </select>
    </label>
    <label>
      <span>Budget ceiling</span>
      <select id="task-budget" name="budget">
        <option value="1">$1 / 1M blended tokens</option>
        <option value="5" selected>$5 / 1M blended tokens</option>
        <option value="10">$10 / 1M blended tokens</option>
        <option value="25">$25 / 1M blended tokens</option>
        <option value="none">No price ceiling</option>
      </select>
    </label>
    <button type="reset" class="task-reset">Reset constraints</button>
  </form>

  <section class="reasoning-evidence" data-reasoning-evidence hidden aria-label="Reasoning benchmark results">
    <p>Source-specific results from Epoch AI. These are the highest reported scores per exact model variant, not recommendations. Test settings differ. Pricing is not attached to these records, so the budget filter does not apply.</p>
    <div class="reasoning-benchmarks">
      {reasoningHighlights.map(benchmark => (
        <article>
          <h2>{benchmark.name}</h2>
          <p>{benchmark.description} {benchmark.runCount} reported runs.</p>
          {benchmark.rows.length ? (
            <ol>
              {benchmark.rows.map(row => (
                <li>
                  <div><strong>{row.name}</strong><small>{row.version}</small></div>
                  <span>{row.score.toFixed(1)}%</span>
                </li>
              ))}
            </ol>
          ) : <p>No valid results in the current source snapshot.</p>}
          <a href={`/compare?metric=epoch_${benchmark.slug}`}>Compare this benchmark</a>
        </article>
      ))}
    </div>
    <p><a href="https://epoch.ai/benchmarks" target="_blank" rel="noopener noreferrer">Source: Epoch AI Benchmarking Hub</a>. SimpleBench results are republished through Epoch, not a separate rerun. Full source records are available in the <a href="/data/epoch-benchmark-snapshot.json">downloaded snapshot</a>.</p>
  </section>

  <div class="shortlist-frame" data-shortlist-frame aria-busy="false">
    <div class="shortlist-head" aria-hidden="true">
      <span>Model</span>
      <span>Why this row is shown</span>
      <span>Price / 1M</span>
      <span>Speed</span>
      <span>Named metric</span>
      <span>Coverage</span>
    </div>

    <p class="shortlist-status sr-only" aria-live="polite" data-shortlist-status>
      {initialCandidates.length
        ? `${initialCandidates.length} models shown in disclosed metric order.`
        : "No models have enough comparable measurements for these filters."}
    </p>
    <div class="shortlist-rows" data-shortlist-rows hidden={initialCandidates.length === 0}>
      {initialCandidates.map((candidate) => {
        const model = candidate.model as WorkbenchModel;
        const benchmark = primaryBenchmark(candidate, defaultPreset);
        return (
          <article class="shortlist-row" data-shortlist-row>
            <div class="candidate-cell" data-label="Model">
              <span class="candidate-mark" aria-hidden="true" />
              <div>
                <h2>{model.label ?? model.id}</h2>
                <p>{model.provider}</p>
              </div>
            </div>
            <div class="reason-cell" data-label="Why this row is shown">
              <p>Has enough named measurements for this comparison.</p>
              <small>{candidate.coverage} of {weightedKeys.length} measurements present</small>
            </div>
            <div class="metric-cell" data-label="Price / 1M">
              <strong>{formatPrice(model.metrics.price_1m_blended_3_to_1)}</strong>
              <small>Input {formatPrice(model.inputPrice)} / output {formatPrice(model.outputPrice)}</small>
            </div>
            <div class="metric-cell" data-label="Speed">
              <strong>{formatMetric(model.metrics.median_output_tokens_per_second)}</strong>
              <small>median tokens/sec</small>
            </div>
            <div class="metric-cell" data-label="Named metric">
              <strong>{benchmark.value}</strong>
              <small>{benchmark.label} · {benchmark.unit}</small>
            </div>
            <div class="metric-cell coverage-cell" data-label="Coverage">
              <strong>{candidate.coverage} / {weightedKeys.length}</strong>
              <small>measurements present</small>
            </div>
            {candidate.missingMetricKeys.length > 0 && (
              <p class="missing-evidence">
                <span>Missing measurements</span>{" "}
                {candidate.missingMetricKeys.map((key) => metricLabels[key] ?? key).join(", ")}
              </p>
            )}
          </article>
        );
      })}
    </div>

    <div class="shortlist-loading" hidden data-shortlist-loading>
      <span aria-hidden="true" />
      <p>Updating comparison</p>
    </div>
    <div
      class="shortlist-empty"
      hidden={initialCandidates.length > 0}
      data-shortlist-empty
      data-shortlist-state="empty"
    >
      <p>
        {models.length
          ? "No models have enough comparable measurements for these filters."
          : "Model measurements are unavailable in this build."}
      </p>
      <span>
        {models.length
          ? "Raise the budget ceiling or remove the price constraint."
          : "Artificial Analysis observations are missing. Epoch and PoliBench measurements remain available below."}
      </span>
      <button type="button" data-empty-reset hidden={models.length === 0}>
        Reset constraints
      </button>
    </div>
  </div>

  <aside class="weights-disclosure" aria-label="How this order is calculated">
    <span>How this order is calculated</span>
    <dl data-weight-list>
      {Object.entries(defaultPreset.weights).map(([key, weight]) => (
        <div>
          <dt>{metricLabels[key] ?? key}</dt>
          <dd>{percent(weight)}</dd>
        </div>
      ))}
    </dl>
    <p data-coverage-rule>
      Values are normalized only within this filtered set. Each row must have at least {defaultPreset.minimumCoverage} of {weightedKeys.length} named measurements. Missing values stay missing. This order describes the selected measurements, it does not recommend a model.
    </p>
  </aside>

  <template id="shortlist-row-template">
    <article class="shortlist-row" data-shortlist-row>
      <div class="candidate-cell" data-label="Model">
        <span class="candidate-mark" aria-hidden="true"></span>
        <div><h2 data-model-name>Candidate</h2><p data-model-provider></p></div>
      </div>
      <div class="reason-cell" data-label="Why this row is shown"><p data-model-reason></p><small data-model-fields></small></div>
      <div class="metric-cell" data-label="Price / 1M"><strong data-model-price></strong><small data-model-price-detail></small></div>
      <div class="metric-cell" data-label="Speed"><strong data-model-speed></strong><small>median tokens/sec</small></div>
      <div class="metric-cell" data-label="Named metric"><strong data-model-benchmark></strong><small data-model-benchmark-detail></small></div>
      <div class="metric-cell coverage-cell" data-label="Coverage"><strong data-model-coverage></strong><small>measurements present</small></div>
      <p class="missing-evidence" data-model-missing hidden><span>Missing measurements</span> <b></b></p>
    </article>
  </template>
</section>

<script
  id="workbench-data"
  type="application/json"
  is:inline
  set:html={workbenchPayloadJson}
></script>

<script>
  import {
    DEFAULT_TASK_PRESETS,
    rankComparableModels,
    type TaskPreset,
  } from "../lib/model-intelligence";

  type WorkbenchPayload = {
    serializeModels: Array<{
      id: string;
      label?: string | null;
      provider: string;
      inputPrice: number | null;
      outputPrice: number | null;
      metrics: Record<string, number | null | undefined>;
    }>;
    taskPresets: import("../lib/model-intelligence").TaskPreset[];
    defaultBudget: number;
  };

  const parseWorkbenchPayload = (): WorkbenchPayload => {
    const fallback: WorkbenchPayload = {
      serializeModels: [],
      taskPresets: DEFAULT_TASK_PRESETS,
      defaultBudget: 5,
    };
    const payloadElement = document.getElementById("workbench-data");
    if (!payloadElement?.textContent) return fallback;
    try {
      const parsed = JSON.parse(payloadElement.textContent) as Partial<WorkbenchPayload>;
      if (
        !Array.isArray(parsed.serializeModels) ||
        !Array.isArray(parsed.taskPresets) ||
        !parsed.taskPresets.length ||
        typeof parsed.defaultBudget !== "number"
      ) {
        return fallback;
      }
      return parsed as WorkbenchPayload;
    } catch {
      return fallback;
    }
  };

  const workbenchPayload = parseWorkbenchPayload();
  const { serializeModels, taskPresets, defaultBudget } = workbenchPayload;

  const root = document.querySelector<HTMLElement>(".task-workbench");
  const form = root?.querySelector<HTMLFormElement>("[data-task-form]");
  const presetSelect = root?.querySelector<HTMLSelectElement>("#task-preset");
  const budgetSelect = root?.querySelector<HTMLSelectElement>("#task-budget");
  const frame = root?.querySelector<HTMLElement>("[data-shortlist-frame]");
  const rows = root?.querySelector<HTMLElement>("[data-shortlist-rows]");
  const status = root?.querySelector<HTMLElement>("[data-shortlist-status]");
  const loading = root?.querySelector<HTMLElement>("[data-shortlist-loading]");
  const empty = root?.querySelector<HTMLElement>("[data-shortlist-empty]");
  const weightList = root?.querySelector<HTMLElement>("[data-weight-list]");
  const coverageRule = root?.querySelector<HTMLElement>("[data-coverage-rule]");
  const rowTemplate = root?.querySelector<HTMLTemplateElement>("#shortlist-row-template");
  const metricLabels: Record<string, string> = {
    aa_coding_index: "AA Coding Index",
    livecodebench: "LiveCodeBench",
    aa_intelligence_index: "AA Intelligence Index",
    gpqa: "GPQA",
    hle: "HLE",
    median_output_tokens_per_second: "Speed",
    price_1m_blended_3_to_1: "Blended price",
  };

  const text = (node: Element | null | undefined, value: string) => {
    if (node) node.textContent = value;
  };
  const money = (value: unknown): string =>
    typeof value === "number" && Number.isFinite(value) ? `$${value.toFixed(2)}` : "Missing";
  const metric = (value: unknown): string =>
    typeof value === "number" && Number.isFinite(value) ? value.toFixed(1) : "Missing";
  const getPreset = () => taskPresets.find((preset) => preset.id === presetSelect?.value) ?? taskPresets[0];
  const weightedKeysFor = (preset: TaskPreset): string[] =>
    Object.keys(preset.weights).filter((key) => preset.weights[key] > 0);

  const renderWeights = (preset: TaskPreset) => {
    if (!weightList) return;
    weightList.replaceChildren();
    Object.entries(preset.weights).forEach(([key, weight]) => {
      const item = document.createElement("div");
      const term = document.createElement("dt");
      const value = document.createElement("dd");
      text(term, metricLabels[key] ?? key);
      text(value, `${Math.round(weight * 100)}%`);
      item.append(term, value);
      weightList.append(item);
    });
  };

  const renderShortlist = () => {
    if (!root || !rows || !rowTemplate || !presetSelect || !budgetSelect || !frame) return;
    const preset = getPreset();
    const isReasoning = preset.id === 'reasoning';
    const reasoning = root.querySelector<HTMLElement>('[data-reasoning-evidence]');
    const weights = root.querySelector<HTMLElement>('.weights-disclosure');
    budgetSelect.disabled = isReasoning;
    frame.hidden = isReasoning;
    if (reasoning) reasoning.hidden = !isReasoning;
    if (weights) weights.hidden = isReasoning;
    if (isReasoning) {
      frame.setAttribute('aria-busy', 'false');
      if (loading) loading.hidden = true;
      root.dataset.shortlistState = 'ready';
      return;
    }
    const budget = budgetSelect.value === "none" ? undefined : Number(budgetSelect.value);
    const ranked = rankComparableModels(
      serializeModels,
      { ...preset, ...(Number.isFinite(budget) ? { budget } : {}) },
    ).slice(0, 3);
    const weightedKeys = weightedKeysFor(preset);
    rows.replaceChildren();

    ranked.forEach((candidate) => {
      const fragment = rowTemplate.content.cloneNode(true) as DocumentFragment;
      const row = fragment.querySelector("[data-shortlist-row]");
      const model = serializeModels.find((entry) => entry.id === candidate.model.id);
      const benchmarkKey = weightedKeys.find(
        (key) => !key.includes("price") && key !== "median_output_tokens_per_second" && candidate.presentMetricKeys.includes(key),
      );
      text(row?.querySelector("[data-model-name]"), model?.label ?? model?.id ?? candidate.model.id);
      text(row?.querySelector("[data-model-provider]"), model?.provider ?? "Unknown provider");
      text(
        row?.querySelector("[data-model-reason]"),
        `Has enough named measurements for ${preset.label.toLowerCase()}${Number.isFinite(budget) ? " within this price ceiling" : ""}.`,
      );
      text(
        row?.querySelector("[data-model-fields]"),
        `${candidate.coverage} of ${weightedKeys.length} measurements present`,
      );
      text(row?.querySelector("[data-model-price]"), money(model?.metrics.price_1m_blended_3_to_1));
      text(row?.querySelector("[data-model-price-detail]"), `Input ${money(model?.inputPrice)} / output ${money(model?.outputPrice)}`);
      text(row?.querySelector("[data-model-speed]"), metric(model?.metrics.median_output_tokens_per_second));
      text(row?.querySelector("[data-model-benchmark]"), benchmarkKey ? metric(model?.metrics[benchmarkKey]) : "Missing");
      text(
        row?.querySelector("[data-model-benchmark-detail]"),
        benchmarkKey
          ? `${metricLabels[benchmarkKey] ?? benchmarkKey} · ${benchmarkKey.startsWith("aa_") ? "index points" : "source-native score"}`
          : "No matching measurement",
      );
      text(row?.querySelector("[data-model-coverage]"), `${candidate.coverage} / ${weightedKeys.length}`);
      const missing = row?.querySelector<HTMLElement>("[data-model-missing]");
      if (missing && candidate.missingMetricKeys.length) {
        missing.hidden = false;
        text(missing.querySelector("b"), candidate.missingMetricKeys.map((key) => metricLabels[key] ?? key).join(", "));
      }
      rows.append(fragment);
    });

    const isEmpty = ranked.length === 0;
    rows.hidden = isEmpty;
    if (empty) empty.hidden = !isEmpty;
    root.dataset.shortlistState = isEmpty ? "empty" : ranked.length < 3 ? "partial" : "ready";
    frame.setAttribute("aria-busy", "false");
    if (loading) loading.hidden = true;
    text(status, isEmpty ? "No models have enough comparable measurements for these filters." : `${ranked.length} models shown with enough named measurements.`);
    text(
      coverageRule,
      `Values are normalized only within this filtered set. Each row must have at least ${preset.minimumCoverage} of ${weightedKeys.length} named measurements. Missing values stay missing. This order describes the selected measurements, it does not recommend a model.`,
    );
    renderWeights(preset);
  };

  const scheduleRender = () => {
    if (!frame) return;
    frame.setAttribute("aria-busy", "true");
    if (loading) loading.hidden = false;
    text(status, "Updating comparison");
    queueMicrotask(renderShortlist);
  };

  form?.addEventListener("change", scheduleRender);
  form?.addEventListener("reset", () => {
    window.setTimeout(() => {
      if (presetSelect) presetSelect.value = taskPresets[0].id;
      if (budgetSelect) budgetSelect.value = String(defaultBudget);
      scheduleRender();
    }, 0);
  });
  root?.querySelector("[data-empty-reset]")?.addEventListener("click", () => form?.reset());
</script>

<style>
  .reasoning-evidence[hidden], .shortlist-frame[hidden], .weights-disclosure[hidden] { display: none; }
  .reasoning-evidence { padding: var(--space-4); color: var(--ink-0); }
  .reasoning-evidence > p { max-width: 80ch; color: var(--ink-1); font-size: var(--text-sm); }
  .reasoning-benchmarks { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); margin: var(--space-4) 0; }
  .reasoning-benchmarks article { min-width: 0; }
  .reasoning-benchmarks h2 { font-size: var(--text-base); font-weight: 600; }
  .reasoning-benchmarks p, .reasoning-benchmarks small { font-size: var(--text-xs); color: var(--ink-2); line-height: var(--leading-snug); }
  .reasoning-benchmarks ol { list-style: none; padding: 0; margin: var(--space-2) 0 0; }
  .reasoning-benchmarks li { display: flex; align-items: start; gap: var(--space-3); justify-content: space-between; border-bottom: 1px solid var(--line-0); padding: var(--space-2) 0; }
  .reasoning-benchmarks li div { min-width: 0; overflow-wrap: anywhere; }
  .reasoning-benchmarks strong { font-size: var(--text-sm); font-weight: 500; }
  .reasoning-benchmarks small { display: block; }
  .reasoning-benchmarks li span { font-family: var(--font-mono); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .reasoning-evidence a { display: inline-block; padding-block: var(--space-2); color: var(--signal); font-weight: 500; text-decoration: underline; text-underline-offset: 0.2em; }
  @media (max-width: 900px) { .reasoning-benchmarks { grid-template-columns: 1fr; } }

  .task-workbench {
    background: var(--surface-1);
    border: 1px solid var(--line-0);
    border-radius: var(--radius-md);
  }

  .task-query {
    display: grid;
    grid-template-columns: auto minmax(14rem, 1fr) minmax(13rem, 0.72fr) auto;
    align-items: end;
    gap: var(--space-4);
    padding: var(--space-4);
    border-bottom: 1px solid var(--line-0);
  }

  .task-query-label {
    align-self: end;
    padding-bottom: 0.7rem;
    color: var(--ink-0);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .task-query label {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .task-query label > span {
    color: var(--ink-2);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .task-query select,
  .task-reset,
  .shortlist-empty button {
    min-height: var(--control-h);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-md);
    background: var(--surface-0);
    color: var(--ink-0);
    font-size: var(--text-sm);
  }

  .task-query select {
    width: 100%;
    padding: 0 2.25rem 0 var(--space-3);
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--ink-2) 50%), linear-gradient(135deg, var(--ink-2) 50%, transparent 50%);
    background-position: calc(100% - 1.05rem) 50%, calc(100% - 0.75rem) 50%;
    background-size: 0.3rem 0.3rem;
    background-repeat: no-repeat;
  }

  .task-reset,
  .shortlist-empty button {
    padding: 0 var(--space-3);
    color: var(--ink-1);
    font-weight: 500;
  }

  .task-reset:hover,
  .shortlist-empty button:hover { background: var(--surface-2); color: var(--ink-0); }

  .shortlist-frame {
    position: relative;
    min-height: 16rem;
  }

  .task-workbench[data-shortlist-state="empty"] .shortlist-frame {
    min-height: 12rem;
  }

  .shortlist-head,
  .shortlist-row {
    display: grid;
    grid-template-columns: 1.45fr 1.15fr 0.82fr 0.72fr 0.92fr 0.72fr;
  }

  .shortlist-head {
    min-height: 2.75rem;
    align-items: center;
    border-bottom: 1px solid var(--line-0);
    color: var(--ink-2);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .shortlist-head span {
    padding: 0 var(--space-4);
  }

  .shortlist-row {
    position: relative;
    border-bottom: 1px solid var(--line-0);
  }

  .shortlist-row > div {
    min-width: 0;
    padding: var(--space-4);
  }

  .candidate-cell {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .candidate-mark {
    width: 0.4rem;
    height: 0.4rem;
    margin-top: 0.55rem;
    border-radius: 50%;
    background: var(--info);
    flex: none;
  }

  .candidate-cell h2 {
    font-size: var(--text-base);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--ink-0);
  }

  .candidate-cell p,
  .reason-cell p,
  .reason-cell small,
  .metric-cell small {
    color: var(--ink-2);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }

  .reason-cell p { color: var(--ink-1); font-size: var(--text-sm); }
  .candidate-cell p { margin-top: 0.2rem; }

  .metric-cell strong {
    display: block;
    color: var(--ink-0);
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .metric-cell small {
    display: block;
    margin-top: 0.25rem;
  }

  .missing-evidence {
    grid-column: 2 / -1;
    margin: calc(-1 * var(--space-2)) var(--space-4) var(--space-3);
    color: var(--ink-2);
    font-size: var(--text-xs);
  }

  .missing-evidence span { color: var(--warn); font-weight: 500; }
  .missing-evidence b { font-weight: 400; }

  .shortlist-loading,
  .shortlist-empty {
    position: absolute;
    inset: 2.75rem 0 0;
