---
const currentYear = new Date().getFullYear();
const related = [
  {
    href: "https://ai-news.helloworldfirm.com/",
    name: "AI News",
    purpose: "What changed in AI, from the original announcements.",
  },
  {
    href: "https://prompt-info.helloworldfirm.com/",
    name: "Prompt Info",
    purpose: "What a prompt or recurring workload costs.",
  },
  {
    href: "https://ai-dragrace.jonathanrreed.com/",
    name: "AI Drag Racing",
    purpose: "How fast a model responds from your own connection.",
  },
  {
    href: "https://polibench.jonathanrreed.com/",
    name: "PoliBench",
    purpose: "Where models land on political questions, and how stable that is.",
  },
];
const sources = [
  { href: "https://artificialanalysis.ai/", name: "Artificial Analysis", note: "Pricing, AA indexes, speed" },
  { href: "https://epoch.ai/benchmarks", name: "Epoch AI", note: "Benchmarking Hub runs" },
  { href: "https://openrouter.ai/", name: "OpenRouter", note: "Catalog and route metadata" },
  { href: "https://huggingface.co/docs/hub/api", name: "Hugging Face", note: "Public model activity" },
  { href: "https://github.com/BerriAI/litellm", name: "LiteLLM", note: "Pricing and capability catalog" },
  { href: "https://polibench.jonathanrreed.com/", name: "PoliBench", note: "Checked political-response snapshot" },
];
---

<footer class="eco-footer footer">
  <div class="eco-container">
    <section class="eco-related" aria-labelledby="related-tools-heading">
      <h2 id="related-tools-heading" class="eco-related-heading">Related tools by the same author</h2>
      <div class="eco-related-grid">
        <div class="eco-related-link" aria-current="true">
          <strong>AI Stats</strong>
          <span>How these models compare on price, speed, context, and named benchmarks.</span>
        </div>
        {related.map((site) => (
          <a href={site.href} class="eco-related-link" rel="noopener">
            <strong>{site.name}</strong>
            <span>{site.purpose}</span>
          </a>
        ))}
      </div>
    </section>

    <div class="eco-footer-groups">
      <nav class="eco-footer-group" aria-labelledby="footer-site-heading">
        <h2 id="footer-site-heading">AI Stats</h2>
        <ul>
          <li><a href="/">Stats</a></li>
          <li><a href="/compare">Compare</a></li>
          <li><a href="/models">Model pages</a></li>
          <li><a href="/about">About and methodology</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/subprocessors">Subprocessors</a></li>
        </ul>
      </nav>
      <nav class="eco-footer-group footer-sources" aria-labelledby="footer-sources-heading">
        <h2 id="footer-sources-heading">Data sources</h2>
        <ul>
          {sources.map((source) => (
            <li>
              <a href={source.href} target="_blank" rel="noopener noreferrer">
                {source.name}<span class="footer-source-note">{source.note}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <nav class="eco-footer-group" aria-labelledby="footer-data-heading">
        <h2 id="footer-data-heading">Open data</h2>
        <ul>
          <li><a href="/api/models.json">Models JSON</a></li>
          <li><a href="/llms-full.txt">Full model listing for assistants</a></li>
          <li><a href="/api/compare-initial.json">Compare snapshot JSON</a></li>
          <li><a href="/data/epoch-benchmark-snapshot.json">Epoch snapshot</a></li>
          <li><a href="/data/polibench-snapshot.json">PoliBench snapshot</a></li>
          <li><a href="https://github.com/JonathanRReed/Ai-stats" target="_blank" rel="noopener noreferrer">Source on GitHub</a></li>
        </ul>
      </nav>
    </div>

    <div class="eco-footer-meta">
      <p>By <a href="https://jonathanrreed.com/" rel="author">Jonathan R. Reed</a>. Measurements come from the named sources and are shown without a combined score.</p>
      <p>aistats.jonathanrreed.com &middot; {currentYear}</p>
    </div>
  </div>
</footer>

<style is:global>
  .footer-sources li a {
    display: grid;
    gap: 0.1rem;
    padding-block: 0.35rem;
  }

  .footer-source-note {
    color: var(--ink-2);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }

  .footer-sources li a:hover .footer-source-note {
    color: var(--ink-1);
  }
</style>
