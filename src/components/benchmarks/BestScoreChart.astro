---
/**
 * Best recorded score against date as a step line, over every dated run. Static SVG drawn at
 * one width for wide screens and one for phones so text stays legible at both.
 */
import { formatScore, formatTick, linearTicks, timeTicks, unitLabel, type BenchmarkCohort } from "../../lib/benchmark-pages";

interface Props {
  cohort: BenchmarkCohort;
  width: number;
  height: number;
  class?: string;
  titleId: string;
  descId: string;
}

const { cohort, width, height, class: className, titleId, descId } = Astro.props;
const { steps, unit, metric, higherIsBetter } = cohort;
const left = width < 500 ? 54 : 66, right = width - (width < 500 ? 14 : 24), top = 16, bottom = height - 44;
const times = steps.dated.map((point) => Date.parse(point.date));
const pad = Math.max(864e5 * 20, (Math.max(...times) - Math.min(...times)) * 0.03);
const t0 = Math.min(...times) - pad, t1 = Math.max(...times) + pad;
const values = steps.dated.map((point) => point.value);
const yMin = unit === "percent" ? 0 : Math.min(0, ...values);
const yTop = unit === "percent" ? 100 : Math.max(...values);
const yTicks = linearTicks(yMin, yTop > yMin ? yTop : yMin + 1, width < 500 ? 4 : 5);
const yMax = Math.max(yTicks[yTicks.length - 1], yTop);
const x = (ms: number) => left + ((ms - t0) / (t1 - t0)) * (right - left);
const y = (value: number) => bottom - ((value - yMin) / (yMax - yMin || 1)) * (bottom - top);
const xTicks = timeTicks(t0, t1, width < 500 ? 4 : 10);
const records = steps.records;
let path = "";
records.forEach((point, index) => {
  const px = x(Date.parse(point.date)), py = y(point.value);
  path += index === 0 ? `M${px.toFixed(1)},${py.toFixed(1)}` : `H${px.toFixed(1)}V${py.toFixed(1)}`;
});
path += `H${right.toFixed(1)}`;
const last = records[records.length - 1];
const lastX = x(Date.parse(last.date)), lastY = y(last.value);
const labelLeft = lastX > right - 160;
const basis = steps.evaluationDated === 0 ? "Model release date" : steps.releaseDated === 0 ? "Evaluation date" : "Release date (evaluation date where no release date is recorded)";
---

<svg class:list={["bench-step-chart", className]} viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${titleId} ${descId}`}>
  <title id={titleId}>Best recorded {metric ?? "score"} over time</title>
  <desc id={descId}>
    Step line of the best recorded score ({higherIsBetter ? "higher is better" : "lower is better"}) across {steps.dated.length} dated runs.
    It reaches {formatScore(last.value, unit)} with {last.modelName} on {last.date}. The record-setting runs are listed in the table below the chart.
  </desc>
  {yTicks.map((tick) => (
    <g>
      <line class="plot-grid" x1={left} x2={right} y1={y(tick)} y2={y(tick)} />
      <text class="plot-tick" x={left - 8} y={y(tick) + 4} text-anchor="end">{formatTick(tick, unit)}</text>
    </g>
  ))}
  {xTicks.map((tick) => (
    <g>
      <line class="plot-tick-mark" x1={x(tick.ms)} x2={x(tick.ms)} y1={bottom} y2={bottom + 5} />
      <text class="plot-tick" x={x(tick.ms)} y={bottom + 18} text-anchor="middle">{tick.label}</text>
    </g>
  ))}
  <line class="plot-axis" x1={left} x2={right} y1={bottom} y2={bottom} />
  <line class="plot-axis" x1={left} x2={left} y1={top} y2={bottom} />
  {steps.dated.map((point) => <circle class="bench-step-run" cx={x(Date.parse(point.date))} cy={y(point.value)} r="2.5" />)}
  <path class="bench-step-line" d={path} />
  {records.map((point) => <circle class="bench-step-record" cx={x(Date.parse(point.date))} cy={y(point.value)} r="4" />)}
  <text class="plot-label bench-step-callout" x={labelLeft ? lastX - 8 : lastX + 8} y={Math.max(top + 10, lastY - 8)} text-anchor={labelLeft ? "end" : "start"}>
    {last.modelName.length > 28 ? `${last.modelName.slice(0, 26)}…` : last.modelName} · {formatScore(last.value, unit)}
  </text>
  <text class="plot-tick bench-axis-title" x={(left + right) / 2} y={height - 6} text-anchor="middle">{basis}</text>
  <text class="plot-tick bench-axis-title" transform={`translate(12 ${(top + bottom) / 2}) rotate(-90)`} text-anchor="middle">{unitLabel(unit, metric).replace(/^./, (c) => c.toUpperCase())}</text>
</svg>
