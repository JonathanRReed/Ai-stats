---
import CohortNotice from "./CohortNotice.astro";
import {assertInitialEpochLeaderboardBudget,buildInitialEpochLeaderboardData} from '../lib/epoch-leaderboard-initial';
import {getEpochLeaderboardSource} from '../lib/epoch-leaderboard-server';
import {modelDisplayFacets} from '../lib/compare-catalog';
import OpenRouterUsage from './OpenRouterUsage';
import {getOpenRouterUsageSnapshot} from '../lib/openrouter-usage-server';
import '../styles/openrouter-usage.css';
import {
  getPublicCatalogModels,
  enrichModelsWithPublicCatalogData,
} from "../lib/supabase";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import ScrollToTop from "./ScrollToTop.astro";
import {
  VALUABLE_FREE_BENCHMARK_SLUGS,
  AA_BENCHMARK_ATTRIBUTION,
  getEpochBenchmarkAttribution,
} from "../lib/benchmark-catalog";
import {getModelCatalogData} from "../lib/model-catalog-data";
import {selectBrowserModels} from "../lib/model-browser";
import CatalogCoverage from "./CatalogCoverage.astro";
import { getDataFreshness } from "../lib/data-freshness";
import TaskWorkbench from "./TaskWorkbench.astro";
import { buildReasoningHighlights } from "../lib/reasoning-highlights";
import SourceHealthStrip from "./SourceHealthStrip.astro";
import OverviewDataStatus from "./OverviewDataStatus.astro";
import IntelligenceOverview from "./IntelligenceOverview.astro";
import PoliBenchLab from "./PoliBenchLab.astro";
import LeaderboardSection from "./dashboard/LeaderboardSection.astro";
import ModelBrowserSection from "./dashboard/ModelBrowserSection.astro";
import PublicCatalogPanel from "./dashboard/PublicCatalogPanel.astro";
import LastVisitStrip from "./dashboard/LastVisitStrip.astro";
import { buildDashboardLeaderboard } from "../lib/dashboard-leaderboard";
import { getPublicPoliBenchSnapshot } from "../lib/polibench-snapshot";
import {
  isCurrentMeasuredModel,
  selectBenchmarkSnapshotModels,
} from "../lib/model-spotlight";
// Global homepage styles. Imported after every child component so they keep
// the cascade position the old inline <style is:global> block had; polish last.
import "./dashboard/styles/shell.css";
import "./dashboard/styles/public-catalog.css";
import "./dashboard/styles/model-browser.css";
import "./dashboard/styles/leaderboard.css";
import "./dashboard/styles/responsive.css";
import "./dashboard/styles/polish.css";

const [catalog, publicCatalogs] =
  await Promise.all([
    getModelCatalogData(),
    getPublicCatalogModels(),
  ]);
const {currentAaModels:baseModels}=catalog;
const {
  openRouterModels,
  openRouterProviders,
  openRouterModelCount,
} = publicCatalogs;
const { epochRuns, epochModels } = catalog.benchmarks;
const models = enrichModelsWithPublicCatalogData(baseModels, publicCatalogs, catalog.bindings);
const publicPoliBenchSnapshot = await getPublicPoliBenchSnapshot();
const dailyUsage = await getOpenRouterUsageSnapshot();

const currentMeasuredModels = models.filter((model) =>
  isCurrentMeasuredModel(model),
);
const initialLeaderboardModels = currentMeasuredModels.map((model) => ({
  id:model.id,name:model.name,company_name:model.company_name,creator_name:model.creator_name,
  source:'aa',current_source_member:model.current_source_member,
  mmlu_pro:model.mmlu_pro,gpqa:model.gpqa,hle:model.hle,aime:model.aime,scicode:model.scicode,
  math_500:model.math_500,livecodebench:model.livecodebench,aa_math_index:model.aa_math_index,
  aa_coding_index:model.aa_coding_index,aa_agentic_index:model.aa_agentic_index,
  aa_intelligence_index:model.aa_intelligence_index,
  reasoning:model.name?modelDisplayFacets(model.name).reasoning:'unknown',
}));
const benchmarkSnapshotModels = selectBenchmarkSnapshotModels(currentMeasuredModels);
const workbenchModels = currentMeasuredModels.map((model) => ({
  id: model.id,
  label: model.name,
  provider: model.company_name ?? model.creator_name ?? "Unknown provider",
  inputPrice: model.price_1m_input_tokens,
  outputPrice: model.price_1m_output_tokens,
  metrics: {
    aa_coding_index: model.aa_coding_index,
    livecodebench: model.livecodebench,
    aa_intelligence_index: model.aa_intelligence_index,
    gpqa: model.gpqa,
    hle: model.hle,
    median_output_tokens_per_second: model.median_output_tokens_per_second,
    price_1m_blended_3_to_1: model.price_1m_blended_3_to_1,
  },
}));

const dataFreshness = await getDataFreshness();

const epochLeaderboard = await getEpochLeaderboardSource();
const {benchmarks: epochBenchmarksWithRuns, labels: epochBenchmarkNames, modelNames: benchmarkModelNameRecord} = epochLeaderboard;
const preferredEpochBenchmarkSlugs = [...VALUABLE_FREE_BENCHMARK_SLUGS];
const initialEpochLeaderboard = buildInitialEpochLeaderboardData(
  epochBenchmarksWithRuns,
  epochRuns,
  epochBenchmarkNames,
  benchmarkModelNameRecord,
);
// Build gate: rendering fails when the real inlined payload exceeds 400,000 UTF-8 bytes.
assertInitialEpochLeaderboardBudget(initialEpochLeaderboard);
const epochRankingRevision = epochLeaderboard.revision;
const epochCorpusFetchedAt = catalog.epoch.fetchedAt ?? null;
const benchmarkAttributions: Record<string, any> = {
  mmlu_pro: AA_BENCHMARK_ATTRIBUTION,
  gpqa: AA_BENCHMARK_ATTRIBUTION,
  hle: AA_BENCHMARK_ATTRIBUTION,
  aime: AA_BENCHMARK_ATTRIBUTION,
  scicode: AA_BENCHMARK_ATTRIBUTION,
  math_500: AA_BENCHMARK_ATTRIBUTION,
  livecodebench: AA_BENCHMARK_ATTRIBUTION,
  aa_math_index: AA_BENCHMARK_ATTRIBUTION,
  aa_coding_index: AA_BENCHMARK_ATTRIBUTION,
  aa_agentic_index: AA_BENCHMARK_ATTRIBUTION,
  aa_intelligence_index: AA_BENCHMARK_ATTRIBUTION,
};
epochBenchmarksWithRuns.forEach((benchmark) => {
  benchmarkAttributions[`epoch_${benchmark.slug}`] = getEpochBenchmarkAttribution(
    benchmark,
    epochRuns,
  );
});
const clientBenchmarkAttributions = benchmarkAttributions;

const validModels = selectBrowserModels(models);
const totalModels = validModels.length;
const INITIAL_VISIBLE_MODELS = Math.min(8, totalModels);
const initialModels = validModels.slice(0, INITIAL_VISIBLE_MODELS);

// Hard facts for the definition block below the h1. Counted from the same
// payloads the bento and the model table render, and each clause is dropped
// when its source came back empty, so the paragraph can never state a zero as
// if it were a real figure.
const openRouterTotal =
  Number(openRouterModelCount?.count) || openRouterModels.length;
const definitionFacts = [
  totalModels > 0
    ? `${totalModels.toLocaleString("en-US")} current measured models with input, output, and blended token prices`
    : null,
  epochRuns.length > 0
    ? `${catalog.epoch.epochModels.length.toLocaleString("en-US")} models scored across ${catalog.epoch.epochBenchmarks.length} Epoch AI benchmarks in ${catalog.epoch.epochRuns.length.toLocaleString("en-US")} recorded runs`
    : null,
  openRouterTotal > 0
    ? `${openRouterTotal.toLocaleString("en-US")} OpenRouter models routed through ${openRouterProviders.length} providers`
    : null,
].filter((fact): fact is string => fact !== null);

// Benchmarks leaderboard rows, totals and families (src/lib/dashboard-leaderboard.ts).
const leaderboard = buildDashboardLeaderboard(
  currentMeasuredModels,
  epochBenchmarksWithRuns,
  epochRuns,
  benchmarkModelNameRecord,
);
// Each Epoch cohort key carries its benchmark's attribution to the client.
for (const [cohortKey, attributionKey] of Object.entries(leaderboard.cohortAttributionKeys)) {
  benchmarkAttributions[cohortKey] = benchmarkAttributions[attributionKey];
}

---

<div class="site-shell min-h-screen bg-base text-text">
  <Header currentPage="dashboard" />

  <main
    id="main-content"
    class="telemetry-main eco-container flex flex-col gap-8 pb-20 pt-2"
  >
    <header class="stats-page-heading">
      <div><h1>AI model stats</h1><p>Benchmarks, prices and usage.</p></div>
      <a href="/compare" class="eco-btn eco-btn-primary">Compare models</a>
    </header>
    <nav class="stats-nav" aria-label="Stats sections">
      <a href="#stats-overview">Overview</a>
      <a href="#stats-benchmarks">Benchmarks</a>
      <a href="#stats-usage">Usage</a>
      <a href="#stats-sources">Sources</a>
    </nav>
    <CohortNotice />
    <LastVisitStrip models={currentMeasuredModels} />
    <section id="stats-overview" class="stats-section" aria-label="Overview">
      <IntelligenceOverview models={currentMeasuredModels} leaders={benchmarkSnapshotModels} />
    </section>
    <section id="stats-benchmarks" class="stats-section" aria-label="Benchmarks">
      <LeaderboardSection leaderboard={leaderboard} benchmarkAttributions={benchmarkAttributions} catalogRecords={catalog.records} />
    </section>
    <section id="stats-usage" class="stats-section" aria-label="Usage">
      <OpenRouterUsage snapshot={dailyUsage?.snapshot ?? null} receipt={dailyUsage?.receipt ?? null} client:visible />
    </section>
    <details class="stats-disclosure" id="stats-tasks">
      <summary><span>Compare by task</span><small>Shortlist models for a task and a budget</small></summary>
      <div class="stats-disclosure-content"><TaskWorkbench models={workbenchModels} reasoningHighlights={buildReasoningHighlights(epochRuns, epochModels)} /></div>
    </details>
    <details class="stats-disclosure" id="stats-profiles">
      <summary><span>Political profiles · PoliBench</span><small>Where models land on political questions, and how stable that is</small></summary>
      <div class="stats-disclosure-content"><PoliBenchLab snapshot={publicPoliBenchSnapshot} /></div>
    </details>
    <details class="stats-disclosure" id="stats-models">
      <summary><span>Browse all models</span><small>Price, speed, context and scores for every model</small></summary>
      <div class="stats-disclosure-content">
        <ModelBrowserSection initialModels={initialModels} totalModels={totalModels} initialVisibleModels={INITIAL_VISIBLE_MODELS} />
      </div>
    </details>
    <details class="stats-disclosure" id="stats-sources">
      <summary><span>Sources and coverage</span><small>Refresh times, source health and what each source covers</small></summary>
      <div class="stats-disclosure-content">
        <SourceHealthStrip freshness={dataFreshness} />
        <OverviewDataStatus models={currentMeasuredModels} epochModels={catalog.epoch.epochModels} epochRuns={catalog.epoch.epochRuns} polibench={publicPoliBenchSnapshot} freshness={dataFreshness} />
        <CatalogCoverage />
        <details class="dashboard-definition">
          <summary>Data in this build</summary>
          <p>{definitionFacts.join("; ")}. Charts update when a new source snapshot is published and the site rebuilds.</p>
        </details>
        <PublicCatalogPanel publicCatalogs={publicCatalogs} models={models} />
      </div>
    </details>
  </main>

  <Footer />
  <ScrollToTop />
</div>

<script is:inline define:vars={{ preferredEpochBenchmarkSlugs, benchmarkAttributions: clientBenchmarkAttributions, initialLeaderboardModels, initialEpochLeaderboard, epochRankingRevision, epochCorpusFetchedAt }}>
  window.__aistatsCatalogDataUrl = "/api/public-catalogs.json";
  window.__aistatsOpenRouterModels = [];
  window.__aistatsHuggingFaceModels = [];
  window.__aistatsLiteLlmModels = [];
  window.__aistatsOpenRouterUsageRankings = [];
  window.__aistatsOpenRouterEndpointSummaries = [];
  window.__aistatsPublicCatalogLoaded = false;
  window.__preferredEpochBenchmarkSlugs = preferredEpochBenchmarkSlugs;
  window.__epochBenchmarkLabels = initialEpochLeaderboard.labels;
  window.__benchmarkAttributions = benchmarkAttributions;
  window.__leaderboardInitialModels = initialLeaderboardModels;
  window.__epochInitialBenchmarks = initialEpochLeaderboard.benchmarks;
  window.__epochInitialRuns = initialEpochLeaderboard.runs;
  window.__epochModelNames = initialEpochLeaderboard.modelNames;
  window.__epochLeaderboardTotals = initialEpochLeaderboard.totals;
  window.__epochRankingRevision = epochRankingRevision;
  window.__epochCorpusFetchedAt = epochCorpusFetchedAt;
</script>

<script>
  import "./dashboard/client/dashboard-client";
</script>

<script>
 const revealStatsTarget=(id:string)=>{
  const target=document.getElementById(id);
  if(!target)return;
  let node:HTMLElement|null=target;
  while(node){if(node instanceof HTMLDetailsElement)node.open=true;node=node.parentElement;}
 };
 document.addEventListener('click',(event)=>{
  if(!(event.target instanceof Element))return;
  if(event.target.closest('[data-openrouter-provider]'))revealStatsTarget('model-browser');
  const link=event.target.closest<HTMLAnchorElement>('a[href^="#"]');
  if(link){try{revealStatsTarget(decodeURIComponent(link.hash.slice(1)));}catch{/* Invalid fragment leaves native navigation unchanged. */}}
 },true);
 const revealCurrentStatsHash=()=>{try{revealStatsTarget(decodeURIComponent(location.hash.slice(1)));}catch{/* Ignore malformed fragments. */}};
 window.addEventListener('hashchange',revealCurrentStatsHash);
 revealCurrentStatsHash();
</script>
